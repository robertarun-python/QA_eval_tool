 "users": {
  "entity": "Member",
  "login_field": "email",
  "password_field": "password",
  "name_field": "name",
  "session_minutes": 30,
  "blocked_when": {
   "eq": [
    {
     "field": "user.status"
    },
    "Suspended"
   ]
  },
  "messages": {
   "required_login": "Email is required",
   "required_password": "Password is required",
   "invalid": "Invalid email or password",
   "blocked": "Your membership is suspended",
   "expired": "Your session has expired. Please log in again.",
   "need_login": "Please log in first"
  }
 },
 "pages": [
  "Login",
  "Home",
  "Search",
  "Book Details",
  "My Books",
  "Borrow Confirmation"
 ],
 "home_page": "Home",
 "queries": [
  {
   "name": "search_books",
   "label": "Search",
   "page": "Search",
   "entity": "Book",
   "match": {
    "input": "term",
    "fields": [
     "title",
     "author",
     "isbn"
    ],
    "mode": "contains",
    "blank": "error:Please enter a title, author or ISBN",
    "max_length": 100,
    "too_long": "Search text must be 100 characters or fewer"
   },
   "order_by": [
    {
     "field": "title"
    }
   ],
   "show": [
    "id",
    "title",
    "author",
    "isbn",
    "available_copies"
   ],
   "none_message": "No books found"
  },
  {
   "name": "open_book",
   "label": "Book details",
   "page": "Search",
   "entity": "Book",
   "key_input": "book_id",
   "missing": "Book not found",
   "next_page": "Book Details",
   "show": [
    "id",
    "title",
    "author",
    "isbn",
    "total_copies",
    "available_copies"
   ]
  },
  {
   "name": "my_loans",
   "label": "My borrowed books",
   "page": "My Books",
   "entity": "Loan",
   "where": {
    "and": [
     {
      "eq": [
       {
        "field": "row.member"
       },
       {
        "user": "email"
       }
      ]
     },
     {
      "eq": [
       {
        "field": "row.status"
       },
       "Borrowed"
      ]
     }
    ]
   },
   "order_by": [
    {
     "field": "borrowed_on"
    }
   ],
   "show": [
    "id",
    "title",
    "borrowed_on",
    "due_on",
    "status"
   ]
  }
 ],
 "actions": [
  {
   "name": "borrow_book",
   "label": "Borrow",
   "page": "Book Details",
   "inputs": [
    {
     "name": "book_id",
     "checks": [
      {
       "rule": "required",
       "message": "Choose a book first"
      }
     ]
    }
   ],
   "load": [
    {
     "as": "book",
     "entity": "Book",
     "key": {
      "input": "book_id"
     },
     "missing": "Book not found"
    }
   ],
   "rules": [
    {
     "unless": {
      "gt": [
       {
        "field": "book.available_copies"
       },
       0
      ]
     },
     "message": "No copies available"
    },
    {
     "when": {
      "exists": {
       "entity": "Loan",
       "where": {
        "and": [
         {
          "eq": [
           {
            "field": "row.member"
           },
           {
            "user": "email"
           }
          ]
         },
         {
          "eq": [
           {
            "field": "row.book"
           },
           {
            "field": "book.id"
           }
          ]
         },
         {
          "eq": [
           {
            "field": "row.status"
           },
           "Borrowed"
          ]
         }
        ]
       }
      }
     },
     "message": "You have already borrowed this book"
    },
    {
     "unless": {
      "lt": [
       {
        "count": {
         "entity": "Loan",
         "where": {
          "and": [
           {
            "eq": [
             {
              "field": "row.member"
             },
             {
              "user": "email"
             }
            ]
           },
           {
            "eq": [
             {
              "field": "row.status"
             },
             "Borrowed"
            ]
           }
          ]
         }
        }
       },
       {
        "user": "borrow_limit"
       }
      ]
     },
     "message": "You have reached your borrowing limit of 5 books"
    }
   ],
   "effects": [
    {
     "set": {
      "record": "book",
      "field": "available_copies",
      "value": {
       "sub": [
        {
         "field": "book.available_copies"
        },
        1
       ]
      }
     }
    },
    {
     "create": {
      "entity": "Loan",
      "as": "loan",
      "values": {
       "member": {
        "user": "email"
       },
       "book": {
        "field": "book.id"
       },
       "title": {
        "field": "book.title"
       },
       "borrowed_on": {
        "today": true
       },
       "due_on": {
        "add_days": [
         {
          "today": true
         },
         14
        ]
       },
       "status": "Borrowed"
      }
     }
    },
    {
     "send": {
      "channel": "email",
      "to": {
       "user": "email"
      },
      "subject": {
       "concat": [
        "Borrowed: ",
        {
         "field": "book.title"
        }
       ]
      }
     }
    }
   ],
   "message": {
    "format": [
     "Book borrowed successfully. Due date: {due}",
     {
      "due": {
       "format_date": [
        {
         "field": "loan.due_on"
        },
        "DD-Mon-YYYY"
       ]
      }
     }
    ]
   },
   "next_page": "Borrow Confirmation",
   "returns": {
    "loan_id": {
     "field": "loan.id"
    },
    "due_on": {
     "field": "loan.due_on"
    }
   }
  },
  {
   "name": "return_book",
   "label": "Return",
   "page": "My Books",
   "inputs": [
    {
     "name": "loan_id",
     "checks": [
      {
       "rule": "required",
       "message": "Choose a loan"
      }
     ]
    }
   ],
   "load": [
    {
     "as": "loan",
     "entity": "Loan",
     "key": {
      "input": "loan_id"
     },
     "missing": "Loan not found"
    },
    {
     "as": "book",
     "entity": "Book",
     "key": {
      "field": "loan.book"
     },
     "missing": "Book not found"
    }
   ],
   "rules": [
    {
     "unless": {
      "and": [
       {
        "eq": [
         {
          "field": "loan.member"
         },
         {
          "user": "email"
         }
        ]
       },
       {
        "eq": [
         {
          "field": "loan.status"
         },
         "Borrowed"
        ]
       }
      ]
     },
     "message": "This book is not borrowed by you"
    }
   ],
   "effects": [
    {
     "set": {
      "record": "loan",
      "field": "status",
      "value": "Returned"
     }
    },
    {
     "set": {
      "record": "book",
      "field": "available_copies",
      "value": {
       "add": [
        {
         "field": "book.available_copies"
        },
        1
       ]
      }
     }
    }
   ],
   "message": "Book returned successfully"
  }
 ],
 "faults": [
  {
   "name": "network_down",
   "applies_to": [
    "borrow_book",
    "return_book"
   ],
   "message": "Network error. Please try again."
  }
 ]
}