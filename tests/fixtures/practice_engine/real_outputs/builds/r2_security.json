    "requires_login": false,
    "inputs": [
     {
      "name": "email",
      "checks": [
       {
        "rule": "required",
        "message": "Email is required"
       }
      ]
     },
     {
      "name": "code",
      "checks": [
       {
        "rule": "required",
        "message": "Code is required"
       }
      ]
     },
     {
      "name": "new_password",
      "checks": [
       {
        "rule": "required",
        "message": "New password is required"
       },
       {
        "rule": "pattern",
        "value": "^(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9]).{8,20}$",
        "message": "Password must be 8-20 characters with an upper-case letter, a digit and a special character"
       }
      ]
     },
     {
      "name": "confirm_password",
      "checks": [
       {
        "rule": "required",
        "message": "Confirm password is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "user",
      "entity": "User",
      "key": {
       "input": "email"
      },
      "missing": "Invalid reset request"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "field": "user.reset_code"
        },
        {
         "input": "code"
        }
       ]
      },
      "message": "Invalid reset code"
     },
     {
      "unless": {
       "le": [
        {
         "minutes_since": {
          "field": "user.reset_code_sent_at"
         }
        },
        10
       ]
      },
      "message": "Code has expired"
     },
     {
      "unless": {
       "eq": [
        {
         "input": "new_password"
        },
        {
         "input": "confirm_password"
        }
       ]
      },
      "message": "Passwords do not match"
     },
     {
      "when": {
       "or": [
        {
         "eq": [
          {
           "input": "new_password"
          },
          {
           "field": "user.password"
          }
         ]
        },
        {
         "matches": [
          {
           "field": "user.password_history"
          },
          "(^|\\|)Newpass@1(\\||$)"
         ]
        },
        {
         "matches": [
          {
           "field": "user.password_history"
          },
          "(^|\\|)Asha@2024(\\||$)"
         ]
        },
        {
