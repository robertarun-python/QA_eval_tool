   "Login",
   "Home",
   "Loans",
   "EMI Details",
   "EMI Payment",
   "Payment Confirmation",
   "Payment History"
  ],
  "home_page": "Home",
  "queries": [
   {
    "name": "view_loans",
    "label": "View Loans",
    "page": "Loans",
    "entity": "Loan",
    "where": {
     "eq": [
      {
       "field": "row.customer_id"
      },
      {
       "user": "customer_id"
      }
     ]
    },
    "order_by": [
     {
      "field": "account_number"
     }
    ],
    "show": [
     "account_number",
     "outstanding_balance",
     "emi_amount",
     "next_emi_date",
     "status"
    ]
   },
   {
    "name": "view_emi_details",
    "label": "View EMI Details",
    "page": "Loans",
    "entity": "Loan",
    "key_input": "loan_account",
    "missing": "Loan account not found",
    "next_page": "EMI Details",
    "show": [
     "account_number",
     "emi_amount",
     "next_emi_date",
     "principal_component",
     "interest_component",
     "outstanding_balance"
    ]
   },
   {
    "name": "get_payment_accounts",
    "label": "Payment Accounts",
    "page": "EMI Payment",
    "entity": "Account",
    "where": {
     "and": [
      {
       "eq": [
        {
         "field": "row.customer_id"
        },
        {
         "user": "customer_id"
        }
       ]
      },
      {
       "eq": [
        {
         "field": "row.status"
        },
        "Active"
       ]
      }
     ]
    },
    "order_by": [
     {
      "field": "account_number"
     }
    ],
    "show": [
     "account_number",
     "account_type",
     "balance"
    ]
   },
   {
    "name": "view_payment_history",
    "label": "Payment History",
    "page": "Payment History",
    "entity": "Payment",
    "where": {
     "eq": [
      {
       "field": "row.loan_account"
      },
      {
       "session": "current_loan"
      }
     ]
    },
    "order_by": [
     {
      "field": "payment_date",
      "desc": true
     }
    ],
    "show": [
     "payment_date",
     "amount",
     "transaction_ref",
     "status"
    ]
   }
  ],
  "actions": [
   {
    "name": "select_loan",
    "label": "Select Loan",
    "page": "Loans",
    "inputs": [
     {
      "name": "loan_account",
      "checks": [
       {
        "rule": "required",
        "message": "Please select a loan account"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "loan",
      "entity": "Loan",
      "key": {
       "input": "loan_account"
      },
      "missing": "Loan account not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "field": "loan.customer_id"
        },
        {
         "user": "customer_id"
        }
       ]
      },
      "message": "This loan does not belong to you"
     }
    ],
    "effects": [
     {
      "set_session": {
       "key": "current_loan",
       "value": {
        "input": "loan_account"
       }
      }
     }
    ],
    "message": "Loan selected",
    "next_page": "EMI Payment"
   },
   {
    "name": "pay_emi",
    "label": "Pay EMI",
    "page": "EMI Payment",
    "inputs": [
     {
      "name": "loan_account",
      "checks": [
       {
        "rule": "required",
        "message": "Loan account is required"
       }
      ]
     },
     {
      "name": "payment_account",
      "checks": [
       {
        "rule": "required",
        "message": "Please select a payment account"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "loan",
      "entity": "Loan",
      "key": {
       "input": "loan_account"
      },
      "missing": "Loan account not found"
     },
     {
      "as": "account",
      "entity": "Account",
      "key": {
       "input": "payment_account"
      },
      "missing": "Payment account not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "field": "loan.customer_id"
        },
        {
         "user": "customer_id"
        }
       ]
      },
      "message": "This loan does not belong to you"
     },
     {
      "unless": {
       "eq": [
        {
         "field": "account.customer_id"
        },
        {
         "user": "customer_id"
        }
       ]
      },
      "message": "This account does not belong to you"
     },
     {
      "unless": {
       "eq": [
        {
         "field": "account.status"
        },
        "Active"
       ]
      },
      "message": "Selected account is inactive. Please choose an active account"
     },
     {
      "when": {
       "and": [
        {
         "ne": [
          {
           "field": "loan.last_payment_date"
          },
          ""
         ]
        },
        {
         "ge": [
          {
           "field": "loan.last_payment_date"
          },
          {
           "today": true
          }
         ]
        }
       ]
      },
      "message": {
       "format": [
        "Current EMI already paid on {date} (Ref: {ref}). Next EMI due: {next}",
        {
         "date": {
          "format_date": [
           {
            "field": "loan.last_payment_date"
           },
           "DD-Mon-YYYY"
          ]
         },
         "ref": {
          "field": "loan.last_payment_txn"
         },
         "next": {
          "format_date": [
           {
            "add_months": [
             {
              "field": "loan.next_emi_date"
             },
             1
            ]
           },
           "DD-Mon-YYYY"
          ]
         }
        }
       ]
      }
     },
     {
      "unless": {
       "ge": [
        {
         "field": "account.balance"
        },
        {
         "field": "loan.emi_amount"
        }
       ]
      },
      "message": {
       "format": [
        "Insufficient balance. Available: {available}, Required: {required}",
        {
         "available": {
          "format_money": [
           {
            "field": "account.balance"
           },
           "INR"
          ]
         },
         "required": {
          "format_money": [
           {
            "field": "loan.emi_amount"
           },
           "INR"
          ]
         }
        }
       ]
      }
     }
    ],
    "effects": [
     {
      "set": {
       "record": "account",
       "field": "balance",
       "value": {
        "sub": [
         {
          "field": "account.balance"
         },
         {
          "field": "loan.emi_amount"
         }
        ]
       }
      }
     },
     {
      "set": {
       "record": "loan",
       "field": "outstanding_balance",
       "value": {
        "sub": [
         {
          "field": "loan.outstanding_balance"
         },
         {
          "field": "loan.principal_component"
         }
        ]
       }
      }
     },
     {
      "create": {
       "entity": "Payment",
       "as": "payment",
       "values": {
        "loan_account": {
         "field": "loan.account_number"
        },
        "payment_account": {
         "field": "account.account_number"
        },
        "amount": {
         "field": "loan.emi_amount"
        },
        "principal": {
         "field": "loan.principal_component"
        },
        "interest": {
         "field": "loan.interest_component"
        },
        "payment_date": {
         "today": true
        },
        "payment_datetime": {
         "now": true
        },
        "status": "Success"
       }
      }
     },
     {
      "set": {
       "record": "loan",
       "field": "last_payment_date",
       "value": {
        "field": "payment.payment_date"
       }
      }
     },
     {
      "set": {
       "record": "loan",
       "field": "last_payment_txn",
       "value": {
        "field": "payment.transaction_ref"
       }
      }
     },
     {
      "set": {
       "record": "loan",
       "field": "next_emi_date",
       "value": {
        "add_months": [
         {
          "field": "loan.next_emi_date"
         },
         1
        ]
       }
      }
     }
    ],
    "message": {
     "format": [
      "Payment successful. Transaction reference: {ref}",
      {
       "ref": {
        "field": "payment.transaction_ref"
       }
      }
     ]
    },
    "returns": {
     "transaction_ref": {
      "field": "payment.transaction_ref"
     },
     "new_balance": {
      "field": "account.balance"
     },
     "new_outstanding": {
      "field": "loan.outstanding_balance"
     }
    },
    "next_page": "Payment Confirmation"
   }
  ],
  "faults": [
   {
    "name": "payment_timeout",
    "applies_to": [
     "pay_emi"
    ],
    "message": "Payment request timed out. Please check payment status before retrying."
   },
   {
    "name": "bank_server_error",
    "applies_to": [
     "pay_emi"
    ],
    "message": "Payment failed due to technical issue. Please try again later. If amount debited, it will be reversed in 24-48 hours."
   }
  ]
 },
