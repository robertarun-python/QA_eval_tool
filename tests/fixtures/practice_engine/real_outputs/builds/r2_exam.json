   "Login",
   "Home",
   "My Results",
   "Request Revaluation"
  ],
  "public_pages": [],
  "home_page": "Home",
  "queries": [
   {
    "name": "view_results",
    "label": "View Results",
    "page": "My Results",
    "entity": "Result",
    "where": {
     "eq": [
      {
       "field": "row.roll_number"
      },
      {
       "user": "roll_number"
      }
     ]
    },
    "rules": [
     {
      "unless": {
       "exists": {
        "entity": "Result",
        "where": {
         "and": [
          {
           "eq": [
            {
             "field": "row.roll_number"
            },
            {
             "user": "roll_number"
            }
           ]
          },
          {
           "eq": [
            {
             "field": "row.published"
            },
            true
           ]
          }
         ]
        }
       }
      },
      "message": "Results are not published yet"
     }
    ],
    "order_by": [
     {
      "field": "subject"
     }
    ],
    "show": [
     "subject",
     "marks",
     "grade",
     "status",
     {
      "name": "overall_result",
      "value": {
       "if": [
        {
         "or": [
          {
           "exists": {
            "entity": "Result",
            "where": {
             "and": [
              {
               "eq": [
                {
                 "field": "row.roll_number"
                },
                {
                 "user": "roll_number"
                }
               ]
              },
              {
               "eq": [
                {
                 "field": "row.status"
                },
                "Absent"
               ]
              }
             ]
            }
           }
          },
          {
           "exists": {
            "entity": "Result",
            "where": {
             "and": [
              {
               "eq": [
                {
                 "field": "row.roll_number"
                },
                {
                 "user": "roll_number"
                }
               ]
              },
              {
               "lt": [
                {
                 "field": "row.marks"
                },
                40
               ]
              },
              {
               "ne": [
                {
                 "field": "row.status"
                },
                "Absent"
               ]
              }
             ]
            }
           }
          }
         ]
        },
        "Fail",
        "Pass"
       ]
      }
     }
    ]
   }
  ],
  "actions": [
   {
    "name": "request_revaluation",
    "label": "Request Revaluation",
    "page": "Request Revaluation",
    "inputs": [
     {
      "name": "subject",
      "checks": [
       {
        "rule": "required",
        "message": "Subject is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "result",
      "entity": "Result",
      "key": {
       "concat": [
        {
         "user": "roll_number"
        },
        "-",
        {
         "input": "subject"
        }
       ]
      },
      "missing": "Result not found for this subject"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "field": "result.published"
        },
        true
       ]
      },
      "message": "Results are not published yet"
     },
     {
      "when": {
       "gt": [
        {
         "days_between": [
          {
           "field": "result.published_on"
          },
          {
           "today": true
          }
         ]
        },
        7
       ]
      },
      "message": "Revaluation window has closed"
     },
     {
      "when": {
       "exists": {
        "entity": "Revaluation",
        "where": {
         "and": [
          {
           "eq": [
            {
             "field": "row.roll_number"
            },
            {
             "user": "roll_number"
            }
           ]
          },
          {
           "eq": [
            {
             "field": "row.subject"
            },
            {
             "input": "subject"
            }
           ]
          }
         ]
        }
       }
      },
      "message": {
       "format": [
        "Revaluation already requested for {subject}",
        {
         "subject": {
          "input": "subject"
         }
        }
       ]
      }
     }
    ],
    "effects": [
     {
      "create": {
       "entity": "Revaluation",
       "as": "revaluation",
       "values": {
        "roll_number": {
         "user": "roll_number"
        },
        "subject": {
         "input": "subject"
        },
        "requested_on": {
         "today": true
        },
        "fee": 500.0,
        "status": "Pending"
       }
      }
     }
    ],
    "message": "Revaluation request created. Fee: ₹500.00",
    "returns": {
     "revaluation_id": {
      "field": "revaluation.id"
     },
     "fee": {
      "field": "revaluation.fee"
     }
    }
   },
   {
    "name": "publish_results",
    "label": "Publish Results",
    "page": "Home",
    "requires_login": false,
    "inputs": [
     {
      "name": "admin_username",
      "checks": [
       {
        "rule": "required",
        "message": "Admin username is required"
       }
      ]
     },
     {
      "name": "admin_password",
      "checks": [
       {
        "rule": "required",
        "message": "Admin password is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "admin",
      "entity": "Admin",
      "key": {
       "input": "admin_username"
      },
      "missing": "Only admins can publish results"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "field": "admin.password"
        },
        {
         "input": "admin_password"
        }
       ]
      },
      "message": "Only admins can publish results"
     }
    ],
    "effects": [
     {
      "for_each": {
       "entity": "Result",
       "where": {
        "eq": [
         {
          "field": "row.published"
         },
         false
        ]
       },
       "as": "r",
       "effects": [
        {
         "set": {
          "record": "r",
          "field": "published",
          "value": true
         }
        },
        {
         "set": {
          "record": "r",
          "field": "published_on",
          "value": {
           "today": true
          }
         }
        }
       ]
      }
     }
    ],
    "message": "Results published successfully"
   }
  ],
  "faults": []
