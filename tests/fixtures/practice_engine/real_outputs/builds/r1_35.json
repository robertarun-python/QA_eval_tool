     "name",
     "account_number",
     "ifsc",
     "account_type",
     "status"
    ],
    "requires_login": true
   },
   {
    "name": "list_active_beneficiaries",
    "label": "Active Beneficiaries",
    "page": "Fund Transfer",
    "entity": "Beneficiary",
    "where": {
     "and": [
      {
       "eq": [
        {
         "field": "row.user_account"
        },
        {
         "user": "account_id"
        }
       ]
      },
      {
       "eq": [
        {
         "field": "row.status"
        },
        "Active"
       ]
      }
     ]
    },
    "order_by": [
     {
      "field": "name"
     }
    ],
    "show": [
     "id",
     "name",
     "account_number",
     "status"
    ]
   }
  ],
  "actions": [
   {
    "name": "submit_beneficiary",
    "label": "Submit",
    "page": "Add Beneficiary",
    "inputs": [
     {
      "name": "beneficiary_name",
      "checks": [
       {
        "rule": "required",
        "message": "Beneficiary name is required"
       }
      ]
     },
     {
      "name": "account_number",
      "checks": [
       {
        "rule": "required",
        "message": "Account number is required"
       },
       {
        "rule": "pattern",
        "value": "[0-9]+",
        "message": "Account number must contain only digits"
       },
       {
        "rule": "pattern",
        "value": "[0-9]{9,18}",
        "message": "Account number must be between 9-18 digits"
       }
      ]
     },
     {
      "name": "ifsc_code",
      "checks": [
       {
        "rule": "required",
        "message": "IFSC code is required"
       },
       {
        "rule": "pattern",
        "value": "[A-Z]{4}0[A-Z0-9]{6}",
        "message": "Invalid IFSC code format. IFSC must be 11 characters"
       }
      ]
     },
     {
      "name": "account_type",
      "checks": [
       {
        "rule": "required",
        "message": "Account type is required"
       },
       {
        "rule": "one_of",
        "value": [
         "Savings",
         "Current"
        ],
        "message": "Account type must be Savings or Current"
       }
      ]
     }
    ],
    "rules": [
     {
      "when": {
       "exists": {
        "entity": "Beneficiary",
        "where": {
         "and": [
          {
           "eq": [
            {
             "field": "row.user_account"
            },
            {
             "user": "account_id"
            }
           ]
          },
          {
           "eq": [
            {
             "field": "row.account_number"
            },
            {
             "input": "account_number"
            }
           ]
          }
         ]
        }
       }
      },
      "message": "Beneficiary with this account number already exists"
     }
    ],
    "effects": [
     {
      "set_session": {
       "key": "pending_beneficiary_name",
       "value": {
        "input": "beneficiary_name"
       }
      }
     },
     {
      "set_session": {
       "key": "pending_account_number",
       "value": {
        "input": "account_number"
       }
      }
     },
     {
      "set_session": {
       "key": "pending_ifsc",
       "value": {
        "input": "ifsc_code"
       }
      }
     },
     {
      "set_session": {
       "key": "pending_account_type",
       "value": {
        "input": "account_type"
       }
      }
     },
     {
      "set_session": {
       "key": "otp",
       "value": "123456"
      }
     },
     {
      "set_session": {
       "key": "otp_sent_at",
       "value": {
        "now": true
       }
      }
     },
     {
      "send": {
       "channel": "sms",
       "to": {
        "user": "account_id"
       },
       "body": "Your OTP is 123456"
      }
     }
    ],
    "message": "OTP sent. Please verify to complete beneficiary addition.",
    "next_page": "OTP Verification"
   },
   {
    "name": "verify_otp_add",
    "label": "Verify",
    "page": "OTP Verification",
    "inputs": [
     {
      "name": "otp",
      "checks": [
       {
        "rule": "required",
        "message": "OTP is required"
       }
      ]
     }
    ],
    "rules": [
     {
      "when": {
       "gt": [
        {
         "minutes_since": {
          "session": "otp_sent_at"
         }
        },
        5
       ]
      },
      "message": "OTP has expired. Please request a new OTP"
     },
     {
      "unless": {
       "eq": [
        {
         "input": "otp"
        },
        {
         "session": "otp"
        }
       ]
      },
      "message": "Invalid OTP. Please try again"
     }
    ],
    "effects": [
     {
      "create": {
       "entity": "Beneficiary",
       "as": "beneficiary",
       "values": {
        "user_account": {
         "user": "account_id"
        },
        "name": {
         "session": "pending_beneficiary_name"
        },
        "account_number": {
         "session": "pending_account_number"
        },
        "ifsc": {
         "session": "pending_ifsc"
        },
        "account_type": {
         "session": "pending_account_type"
        },
        "status": "Active"
       }
      }
     },
     {
      "clear_session": "pending_beneficiary_name"
     },
     {
      "clear_session": "pending_account_number"
     },
     {
      "clear_session": "pending_ifsc"
     },
     {
      "clear_session": "pending_account_type"
     },
     {
      "clear_session": "otp"
     },
     {
      "clear_session": "otp_sent_at"
     }
    ],
    "message": "Beneficiary added successfully",
    "next_page": "Beneficiary List",
    "returns": {
     "beneficiary_id": {
      "field": "beneficiary.id"
     },
     "status": {
      "field": "beneficiary.status"
     }
    }
   },
   {
    "name": "initiate_delete",
    "label": "Delete",
    "page": "Beneficiary List",
    "inputs": [
     {
      "name": "beneficiary_id",
      "checks": [
       {
        "rule": "required",
        "message": "Beneficiary ID is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "beneficiary",
      "entity": "Beneficiary",
      "key": {
       "input": "beneficiary_id"
      },
      "missing": "Beneficiary not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "field": "beneficiary.user_account"
        },
        {
         "user": "account_id"
        }
       ]
      },
      "message": "You can only delete your own beneficiaries"
     }
    ],
    "effects": [
     {
      "set_session": {
       "key": "delete_beneficiary_id",
       "value": {
        "input": "beneficiary_id"
       }
      }
     },
     {
      "set_session": {
       "key": "delete_otp",
       "value": "789012"
      }
     },
     {
      "set_session": {
       "key": "delete_otp_sent_at",
       "value": {
        "now": true
       }
      }
     },
     {
      "send": {
       "channel": "sms",
       "to": {
        "user": "account_id"
       },
       "body": "Your OTP for deletion is 789012"
      }
     }
    ],
    "message": "OTP sent. Please verify to confirm deletion.",
    "next_page": "Delete Confirmation"
   },
   {
    "name": "verify_otp_delete",
    "label": "Verify",
    "page": "Delete Confirmation",
    "inputs": [
     {
      "name": "otp",
      "checks": [
       {
        "rule": "required",
        "message": "OTP is required"
       }
      ]
     }
    ],
    "rules": [
     {
      "when": {
       "gt": [
        {
         "minutes_since": {
          "session": "delete_otp_sent_at"
         }
        },
        5
       ]
      },
      "message": "OTP has expired. Please request a new OTP"
     },
     {
      "unless": {
       "eq": [
        {
         "input": "otp"
        },
        {
         "session": "delete_otp"
        }
       ]
      },
      "message": "Invalid OTP. Please try again"
     }
    ],
    "load": [
     {
      "as": "beneficiary",
      "entity": "Beneficiary",
      "key": {
       "session": "delete_beneficiary_id"
      },
      "missing": "Beneficiary not found"
     }
    ],
    "effects": [
     {
      "delete": {
       "record": "beneficiary"
      }
     },
     {
      "clear_session": "delete_beneficiary_id"
     },
     {
      "clear_session": "delete_otp"
     },
     {
      "clear_session": "delete_otp_sent_at"
     }
    ],
    "message": "Beneficiary deleted",
    "next_page": "Beneficiary List"
   },
   {
    "name": "initiate_transfer",
    "label": "Transfer",
    "page": "Fund Transfer",
    "inputs": [
     {
      "name": "beneficiary_id",
      "checks": [
       {
        "rule": "required",
        "message": "Please select a beneficiary"
       }
      ]
     },
     {
      "name": "amount",
      "checks": [
       {
        "rule": "required",
        "message": "Amount is required"
       },
       {
        "rule": "number",
        "message": "Amount must be a valid number"
       },
       {
        "rule": "min",
        "value": 1,
        "message": "Amount must be greater than zero"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "beneficiary",
      "entity": "Beneficiary",
      "key": {
       "input": "beneficiary_id"
      },
      "missing": "Beneficiary not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "field": "beneficiary.user_account"
        },
        {
         "user": "account_id"
        }
       ]
      },
      "message": "Invalid beneficiary"
     },
     {
      "unless": {
       "eq": [
        {
         "field": "beneficiary.status"
        },
        "Active"
       ]
      },
      "message": "Cannot transfer to unapproved beneficiary. Please wait for approval"
     }
    ],
    "effects": [],
    "message": "Transfer initiated successfully"
   }
  ],
  "faults": [
