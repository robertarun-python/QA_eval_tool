     "too_long": "Search text must be 100 characters or fewer"
    },
    "order_by": [
     {
      "field": "title"
     }
    ],
    "show": [
     "id",
     "title",
     "author",
     "isbn",
     "available_copies"
    ],
    "none_message": "No results found"
   },
   {
    "name": "open_book",
    "label": "Book details",
    "page": "Search",
    "entity": "Book",
    "key_input": "book_id",
    "missing": "Book not found",
    "next_page": "Book Details",
    "show": [
     "id",
     "title",
     "author",
     "isbn",
     "total_copies",
     "available_copies"
    ]
   },
   {
    "name": "view_book_details",
    "label": "Book details",
    "page": "Book Details",
    "entity": "Book",
    "key_input": "book_id",
    "missing": "Book not found",
    "show": [
     "id",
     "title",
     "author",
     "isbn",
     "total_copies",
     "available_copies",
     {
      "name": "availability_status",
      "value": {
       "if": [
        {
         "gt": [
          {
           "field": "row.available_copies"
          },
          0
         ]
        },
        "Available",
        "Not Available"
       ]
      }
     }
    ]
   },
   {
    "name": "my_loans",
    "label": "My borrowed books",
    "page": "My Books",
    "entity": "Loan",
    "where": {
     "and": [
      {
       "eq": [
        {
         "field": "row.member"
        },
        {
         "user": "username"
        }
       ]
      },
      {
       "eq": [
        {
         "field": "row.status"
        },
        "Borrowed"
       ]
      }
     ]
    },
    "order_by": [
     {
      "field": "borrowed_on"
     }
    ],
    "show": [
     "id",
     "book_title",
     "borrowed_on",
     "due_on",
     "status"
    ]
   }
  ],
  "actions": [
   {
    "name": "borrow_book",
    "label": "Borrow",
    "page": "Book Details",
    "inputs": [
     {
      "name": "book_id",
      "checks": [
       {
        "rule": "required",
        "message": "Book ID is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "book",
      "entity": "Book",
      "key": {
       "input": "book_id"
      },
      "missing": "Book not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "gt": [
        {
         "field": "book.available_copies"
        },
        0
       ]
      },
      "message": "No copies available"
     },
     {
      "when": {
       "exists": {
        "entity": "Loan",
        "where": {
         "and": [
          {
           "eq": [
            {
             "field": "row.member"
            },
            {
             "user": "username"
            }
           ]
          },
          {
           "eq": [
            {
             "field": "row.book_id"
            },
            {
             "field": "book.id"
            }
           ]
          },
          {
           "eq": [
            {
             "field": "row.status"
            },
            "Borrowed"
           ]
          }
         ]
        }
       }
      },
      "message": "You have already borrowed this book"
     },
     {
      "unless": {
       "lt": [
        {
         "count": {
          "entity": "Loan",
          "where": {
           "and": [
            {
             "eq": [
              {
               "field": "row.member"
              },
              {
               "user": "username"
              }
             ]
            },
            {
             "eq": [
              {
               "field": "row.status"
              },
              "Borrowed"
             ]
            }
           ]
          }
         }
        },
        {
         "user": "borrow_limit"
        }
       ]
      },
      "message": "You have reached your borrowing limit"
     }
    ],
    "effects": [
     {
      "set": {
       "record": "book",
       "field": "available_copies",
       "value": {
        "sub": [
         {
          "field": "book.available_copies"
         },
         1
        ]
       }
      }
     },
     {
      "create": {
       "entity": "Loan",
       "as": "loan",
       "values": {
        "member": {
         "user": "username"
        },
        "book_id": {
         "field": "book.id"
        },
        "book_title": {
         "field": "book.title"
        },
        "borrowed_on": {
         "today": true
        },
        "due_on": {
         "add_days": [
          {
           "today": true
          },
          14
         ]
        },
        "status": "Borrowed"
       }
      }
     }
    ],
    "message": "Book borrowed successfully",
    "next_page": "Borrow Confirmation",
    "returns": {
     "loan_id": {
      "field": "loan.id"
     },
     "book_title": {
      "field": "loan.book_title"
     },
     "author": {
      "field": "book.author"
     },
     "borrowed_on": {
      "field": "loan.borrowed_on"
     },
     "due_on": {
      "field": "loan.due_on"
     }
    }
   },
   {
    "name": "return_book",
    "label": "Return",
    "page": "My Books",
    "inputs": [
     {
      "name": "loan_id",
      "checks": [
       {
        "rule": "required",
        "message": "Loan ID is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "loan",
      "entity": "Loan",
      "key": {
       "input": "loan_id"
      },
      "missing": "Loan not found"
     },
     {
      "as": "book",
      "entity": "Book",
      "key": {
       "field": "loan.book_id"
      },
      "missing": "Book not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "and": [
        {
         "eq": [
          {
           "field": "loan.member"
          },
          {
           "user": "username"
          }
         ]
        },
        {
         "eq": [
          {
           "field": "loan.status"
          },
          "Borrowed"
         ]
        }
       ]
      },
      "message": "This book is not borrowed by you"
     }
    ],
    "effects": [
     {
      "set": {
       "record": "loan",
       "field": "status",
       "value": "Returned"
      }
     },
     {
      "set": {
       "record": "book",
       "field": "available_copies",
       "value": {
        "add": [
         {
          "field": "book.available_copies"
         },
         1
        ]
       }
      }
     }
    ],
    "message": "Book returned successfully"
   }
  ],
