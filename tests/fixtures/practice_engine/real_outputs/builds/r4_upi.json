       "values": {
        "from_mobile": {
         "user": "mobile"
        },
        "to_upi": {
         "input": "upi_id"
        },
        "amount": {
         "input": "amount"
        },
        "timestamp": {
         "now": true
        },
        "status": "Success"
       }
      }
     },
     {
      "send": {
       "channel": "sms",
       "to": {
        "user": "mobile"
       },
       "body": {
        "format": [
         "Rs {amount} sent to {upi}. Balance: Rs {balance}",
         {
          "amount": {
           "input": "amount"
          },
          "upi": {
           "input": "upi_id"
          },
          "balance": {
           "field": "current_user.balance"
          }
         }
        ]
       }
      }
     }
    ],
    "message": "Payment successful",
    "next_page": "Payment Success",
    "returns": {
     "transaction_id": {
      "field": "txn.id"
     },
     "new_balance": {
      "field": "current_user.balance"
     }
    }
   }
