      "field": "timestamp",
      "desc": true
     }
    ],
    "show": [
     "id",
     "to_upi",
     "amount",
     "timestamp",
     "status"
    ]
   }
  ],
  "actions": [
   {
    "name": "send_money",
    "label": "Pay",
    "page": "Send Money",
    "inputs": [
     {
      "name": "upi_id",
      "checks": [
       {
        "rule": "required",
        "message": "UPI ID is required"
       },
       {
        "rule": "pattern",
        "value": "[a-zA-Z0-9._-]+@[a-zA-Z0-9]+",
        "message": "Enter a valid UPI ID"
       }
      ]
     },
     {
      "name": "amount",
      "checks": [
       {
        "rule": "required",
        "message": "Amount is required"
       },
       {
        "rule": "number",
        "message": "Amount must be a number"
       },
       {
        "rule": "min",
        "value": 1,
        "message": "Enter an amount of at least Rs 1"
       },
       {
        "rule": "max",
        "value": 50000,
        "message": "Maximum Rs 50,000 per transaction"
       }
      ]
     },
     {
      "name": "upi_pin",
      "checks": [
       {
        "rule": "required",
        "message": "UPI PIN is required"
       },
       {
        "rule": "pattern",
        "value": "[0-9]{4}",
        "message": "UPI PIN must be 4 digits"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "current_user",
      "entity": "User",
      "key": {
       "user": "mobile"
      },
      "missing": "User not found"
     }
    ],
    "rules": [
     {
      "when": {
       "ne": [
        {
         "sub": [
          {
           "mul": [
            {
             "input": "amount"
            },
            100
           ]
          },
          {
           "round": [
            {
             "mul": [
              {
               "input": "amount"
              },
              100
             ]
            },
            0
           ]
          }
         ]
        },
        0
       ]
      },
      "message": "Amount can have at most 2 decimal places"
     },
     {
      "when": {
       "and": [
        {
         "not": {
          "empty": {
           "field": "current_user.upi_blocked_at"
          }
         }
        },
        {
         "le": [
          {
           "minutes_since": {
            "field": "current_user.upi_blocked_at"
           }
          },
          1440
         ]
        }
       ]
      },
      "message": "UPI blocked for 24 hours due to wrong PIN attempts"
     },
     {
      "unless": {
       "eq": [
        {
         "input": "upi_pin"
        },
        {
         "field": "current_user.upi_pin"
        }
       ]
      },
      "message": "Incorrect UPI PIN",
      "then": [
       {
        "set": {
         "record": "current_user",
         "field": "wrong_pin_count",
         "value": {
          "add": [
           {
            "field": "current_user.wrong_pin_count"
           },
           1
          ]
         }
        }
       },
       {
        "if": [
         {
          "ge": [
           {
            "field": "current_user.wrong_pin_count"
           },
           3
          ]
         },
         [
          {
           "set": {
            "record": "current_user",
            "field": "upi_blocked_at",
            "value": {
             "now": true
            }
           }
          }
         ],
         []
        ]
       }
      ]
     },
     {
      "when": {
       "and": [
        {
         "ge": [
          {
           "field": "current_user.wrong_pin_count"
          },
          3
         ]
        },
        {
         "not": {
          "empty": {
           "field": "current_user.upi_blocked_at"
          }
         }
        },
        {
         "le": [
          {
           "minutes_since": {
            "field": "current_user.upi_blocked_at"
           }
          },
          1440
         ]
        }
       ]
      },
      "message": "UPI blocked for 24 hours due to wrong PIN attempts"
     },
     {
      "unless": {
       "ge": [
        {
         "field": "current_user.balance"
        },
        {
         "input": "amount"
        }
       ]
      },
      "message": "Insufficient balance"
     },
     {
      "when": {
       "gt": [
        {
         "add": [
          {
           "sum": {
            "entity": "Transaction",
            "where": {
             "and": [
              {
               "eq": [
                {
                 "field": "row.from_mobile"
                },
                {
                 "user": "mobile"
                }
               ]
              },
              {
               "eq": [
                {
                 "field": "row.status"
                },
                "Success"
               ]
              },
              {
               "ge": [
                {
                 "field": "row.timestamp"
                },
                {
                 "format": [
                  "{date}T00:00",
                  {
                   "date": {
                    "today": true
                   }
                  }
                 ]
                }
               ]
              }
             ]
            },
            "field": "amount"
           }
          },
          {
           "input": "amount"
          }
         ]
        },
        100000
       ]
      },
      "message": "Daily limit of Rs 1,00,000 reached"
     }
    ],
    "effects": [
     {
      "set": {
       "record": "current_user",
       "field": "balance",
       "value": {
        "sub": [
         {
          "field": "current_user.balance"
         },
         {
          "input": "amount"
         }
        ]
       }
      }
     },
     {
      "set": {
       "record": "current_user",
       "field": "wrong_pin_count",
       "value": 0
      }
     },
     {
      "set": {
       "record": "current_user",
       "field": "upi_blocked_at",
       "value": ""
      }
     },
     {
      "create": {
       "entity": "Transaction",
