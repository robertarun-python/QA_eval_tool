    "entity": "Transaction",
    "match": {
     "input": "tag_id",
     "fields": [
      "tag_id"
     ],
     "mode": "equals",
     "blank": "error:Please enter FASTag ID"
    },
    "order_by": [
     {
      "field": "timestamp",
      "desc": true
     }
    ],
    "show": [
     "id",
     "registration_number",
     "vehicle_type",
     "toll_plaza",
     "toll_amount",
     "balance_after",
     "timestamp",
     "status"
    ],
    "none_message": "No transactions found for this FASTag",
    "requires_login": false
   }
  ],
  "actions": [
   {
    "name": "process_toll",
    "label": "Process Toll",
    "page": "Toll Plaza",
    "inputs": [
     {
      "name": "tag_id",
      "checks": [
       {
        "rule": "required",
        "message": "FASTag ID is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "tag",
      "entity": "FASTag",
      "key": {
       "input": "tag_id"
      },
      "missing": "FASTag not detected"
     },
     {
      "as": "vehicle",
      "entity": "Vehicle",
      "key": {
       "field": "tag.registration_number"
      },
      "missing": "Vehicle not found"
     },
     {
      "as": "rate",
      "entity": "TollRate",
      "key": {
       "field": "vehicle.vehicle_type"
      },
      "missing": "Toll rate not configured for this vehicle type"
     }
    ],
    "rules": [
     {
      "when": {
       "eq": [
        {
         "field": "tag.status"
        },
        "Expired"
       ]
      },
      "message": "FASTag is expired or inactive"
     },
     {
      "when": {
       "eq": [
        {
         "field": "tag.status"
        },
        "Inactive"
       ]
      },
      "message": "FASTag is expired or inactive"
     },
     {
      "when": {
       "ne": [
        {
         "field": "tag.registration_number"
        },
        {
         "field": "vehicle.registration_number"
        }
       ]
      },
      "message": "Vehicle-FASTag mismatch detected"
     },
     {
      "unless": {
       "ge": [
        {
         "field": "tag.balance"
        },
        {
         "field": "rate.toll_amount"
        }
       ]
      },
      "message": "Insufficient balance"
     }
    ],
    "effects": [
     {
      "set": {
       "record": "tag",
       "field": "balance",
       "value": {
        "sub": [
         {
          "field": "tag.balance"
         },
         {
          "field": "rate.toll_amount"
         }
        ]
       }
      }
     },
     {
      "create": {
       "entity": "Transaction",
       "as": "txn",
       "values": {
        "tag_id": {
         "field": "tag.tag_id"
        },
        "registration_number": {
         "field": "vehicle.registration_number"
        },
        "vehicle_type": {
         "field": "vehicle.vehicle_type"
        },
        "toll_plaza": "Delhi-Jaipur Plaza",
        "toll_amount": {
         "field": "rate.toll_amount"
        },
        "balance_before": {
         "add": [
          {
           "field": "tag.balance"
          },
          {
           "field": "rate.toll_amount"
          }
         ]
        },
        "balance_after": {
         "field": "tag.balance"
        },
        "timestamp": {
         "now": true
        },
        "status": "Success"
       }
      }
     },
     {
      "send": {
       "channel": "sms",
       "to": {
        "field": "vehicle.owner_mobile"
       },
       "body": {
        "format": [
         "FASTag deducted: ₹{amount} at {plaza}. Balance: ₹{balance}. Txn ID: {txn_id}",
         {
          "amount": {
           "field": "rate.toll_amount"
          },
          "plaza": "Delhi-Jaipur Plaza",
          "balance": {
           "field": "tag.balance"
          },
          "txn_id": {
           "field": "txn.id"
          }
         }
        ]
       }
      }
     },
     {
      "if": [
       {
        "le": [
         {
          "field": "tag.balance"
         },
         50.0
        ]
       },
       [
        {
         "send": {
          "channel": "alert",
          "to": {
           "field": "vehicle.owner_mobile"
          },
          "body": {
           "format": [
            "Low balance alert: Your FASTag balance is ₹{balance}. Please recharge.",
            {
             "balance": {
              "field": "tag.balance"
             }
            }
           ]
          }
         }
        }
       ],
       []
      ]
     }
    ],
    "message": "Toll deducted successfully. Barrier opening.",
    "returns": {
     "transaction_id": {
      "field": "txn.id"
     },
     "toll_amount": {
      "field": "rate.toll_amount"
     },
     "balance_after": {
      "field": "tag.balance"
     }
    },
    "next_page": "Transaction Result",
    "requires_login": false
   }
  ],
  "faults": []
 },
