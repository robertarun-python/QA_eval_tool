      "checks": [
       {
        "rule": "required",
        "message": "Card number is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "card",
      "entity": "CreditCard",
      "key": {
       "input": "card_number"
      },
      "missing": "Card not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "field": "card.customer_username"
        },
        {
         "user": "username"
        }
       ]
      },
      "message": "You can only block your own cards"
     },
     {
      "when": {
       "eq": [
        {
         "field": "card.status"
        },
        "Blocked"
       ]
      },
      "message": "Card is already blocked"
     }
    ],
    "effects": [
     {
      "set": {
       "record": "card",
       "field": "status",
       "value": "Blocked"
      }
