      "set": {
       "record": "card",
       "field": "available_credit",
       "value": {
        "sub": [
         {
          "field": "card.available_credit"
         },
         {
          "input": "amount"
         }
        ]
       }
      }
     }
    ],
    "message": "Transaction approved successfully",
