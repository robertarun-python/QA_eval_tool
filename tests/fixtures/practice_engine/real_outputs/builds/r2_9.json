      "key": {
       "input": "card_number"
      },
      "missing": "Card not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "field": "card.customer_username"
        },
        {
         "user": "username"
        }
       ]
      },
