    "next_page": "Doctor Profile",
    "show": [
     "id",
     "name",
     "specialty",
     "experience_years",
     "consultation_fee"
    ]
   },
   {
    "name": "view_available_slots",
    "label": "Available slots",
    "page": "Doctor Profile",
    "entity": "Slot",
    "inputs": [
     {
      "name": "doctor_id",
      "checks": [
       {
        "rule": "required",
        "message": "Doctor ID is required"
       }
      ]
     },
     {
      "name": "slot_date",
      "checks": [
       {
        "rule": "required",
        "message": "Date is required"
       }
      ]
     }
    ],
    "where": {
     "and": [
      {
       "eq": [
        {
         "field": "row.doctor_id"
        },
        {
         "input": "doctor_id"
        }
       ]
      },
      {
       "eq": [
        {
         "field": "row.slot_date"
        },
        {
         "input": "slot_date"
        }
       ]
      },
      {
       "eq": [
        {
         "field": "row.status"
        },
        "Available"
       ]
      }
     ]
    },
    "order_by": [
     {
      "field": "slot_time"
     }
    ],
    "show": [
     "id",
     "slot_date",
     "slot_time",
     "status"
    ],
    "none_message": "No slots available for this date"
   }
  ],
  "actions": [
   {
    "name": "book_appointment",
    "label": "Book appointment",
    "page": "Doctor Profile",
    "inputs": [
     {
      "name": "slot_id",
      "checks": [
       {
        "rule": "required",
        "message": "Please select a time slot"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "slot",
      "entity": "Slot",
      "key": {
       "input": "slot_id"
      },
      "missing": "Slot not found"
     },
     {
      "as": "doctor",
      "entity": "Doctor",
      "key": {
       "field": "slot.doctor_id"
      },
      "missing": "Doctor not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "field": "slot.status"
        },
        "Available"
       ]
      },
      "message": "This slot is no longer available"
     }
    ],
    "effects": [
     {
      "set": {
       "record": "slot",
       "field": "status",
       "value": "Booked"
      }
     },
     {
      "create": {
       "entity": "Appointment",
       "as": "appointment",
       "values": {
        "patient_email": {
         "user": "email"
        },
        "doctor_id": {
         "field": "doctor.id"
        },
        "doctor_name": {
         "field": "doctor.name"
        },
        "specialty": {
         "field": "doctor.specialty"
        },
        "appointment_date": {
         "field": "slot.slot_date"
        },
        "appointment_time": {
         "field": "slot.slot_time"
        },
        "consultation_fee": {
         "field": "doctor.consultation_fee"
        },
        "status": "Confirmed",
        "booked_at": {
         "now": true
        }
       }
      }
     }
    ],
    "message": "Appointment booked successfully",
    "next_page": "Appointment Confirmation",
    "returns": {
