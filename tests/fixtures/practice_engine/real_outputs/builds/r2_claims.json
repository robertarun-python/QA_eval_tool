   {
    "name": "mark_paid",
    "label": "Mark as Paid",
    "page": "Claim Details",
    "inputs": [
     {
      "name": "claim_id",
      "checks": [
       {
        "rule": "required",
        "message": "Claim ID is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "claim",
      "entity": "Claim",
      "key": {
       "input": "claim_id"
      },
      "missing": "Claim not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "user": "role"
        },
        "reviewer"
       ]
      },
      "message": "You are not allowed to do this"
