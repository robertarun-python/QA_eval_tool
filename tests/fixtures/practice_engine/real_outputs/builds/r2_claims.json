  {
   "id": "submit-valid-claim",
   "title": "Submit a valid claim",
   "steps": [
    {
     "call": "setup"
    },
    {
     "call": "UI.login",
     "args": [
      "holder@claims.test",
      "Holder@123"
     ],
     "expect": true
    },
    {
     "call": "UI.open",
     "args": [
      "Submit Claim"
     ],
     "expect": true
    },
