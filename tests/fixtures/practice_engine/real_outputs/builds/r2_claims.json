    {
     "call": "UI.visible_message",
     "expect_includes": "submitted successfully"
    },
    {
     "call": "UI.last_result",
     "save_as": "claim_result"
    },
    {
     "check": {
      "ref": "claim_result.status"
     },
     "expect": "Submitted"
    },
    {
     "call": "Database.get_claim",
     "args": [
      {
       "ref": "claim_result.claim_id"
      }
     ],
     "save_as": "claim"
    },
    {
     "check": {
      "ref": "claim.hospital_name"
     },
     "expect": "Apollo"
    },
    {
     "check": {
      "ref": "claim.admission_date"
     },
     "expect": "2024-03-01"
    },
    {
     "check": {
      "ref": "claim.discharge_date"
     },
     "expect": "2024-03-04"
    },
    {
     "check": {
      "ref": "claim.claim_amount"
     },
     "expect": 45000.0
    },
    {
     "check": {
      "ref": "claim.document_name"
     },
     "expect": "bill.pdf"
    },
    {
     "check": {
      "ref": "claim.document_size_mb"
     },
     "expect": 2
    },
    {
     "check": {
      "ref": "claim.status"
     },
     "expect": "Submitted"
    },
    {
     "call": "teardown",
     "args": [
      {
       "ref": "claim_result.claim_id"
      }
     ]
    }
   ],
   "recorded_pass": true
