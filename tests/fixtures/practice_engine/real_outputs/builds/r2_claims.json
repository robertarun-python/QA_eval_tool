        "rule": "required",
        "message": "Claim ID is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "claim",
      "entity": "Claim",
      "key": {
       "input": "claim_id"
      },
      "missing": "Claim not found"
     },
     {
      "as": "holder",
      "entity": "PolicyHolder",
      "key": {
       "field": "claim.policy_holder"
      },
      "missing": "Policy holder not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "user": "role"
        },
        "reviewer"
       ]
      },
      "message": "You are not allowed to do this"
     },
     {
      "unless": {
       "eq": [
        {
         "field": "claim.status"
        },
        "Under Review"
       ]
      },
      "message": "Claim must be Under Review first"
     }
    ],
    "effects": [
     {
      "set": {
       "record": "claim",
       "field": "status",
       "value": "Approved"
      }
     },
     {
      "set": {
       "record": "claim",
       "field": "deductible",
       "value": 2000
      }
     },
     {
      "set": {
       "record": "claim",
       "field": "approved_amount",
       "value": {
        "sub": [
         {
          "field": "claim.claim_amount"
         },
         2000
        ]
       }
      }
     },
     {
      "set": {
       "record": "holder",
       "field": "remaining_sum_insured",
       "value": {
        "sub": [
         {
          "field": "holder.remaining_sum_insured"
         },
         {
          "field": "claim.claim_amount"
         }
        ]
       }
      }
     },
     {
      "send": {
       "channel": "sms",
       "to": {
        "field": "holder.mobile"
       },
       "body": {
        "format": [
         "Your claim {id} has been approved. Approved amount: {amount}",
         {
          "id": {
           "field": "claim.id"
          },
          "amount": {
           "format_money": [
            {
             "field": "claim.approved_amount"
            },
            "INR"
           ]
          }
         }
        ]
       }
      }
     }
    ],
    "message": "Claim approved successfully",
    "returns": {
     "approved_amount": {
      "field": "claim.approved_amount"
     }
    }
   },
