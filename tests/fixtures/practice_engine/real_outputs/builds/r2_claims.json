  "actions": [
   {
    "name": "submit_claim",
    "label": "Submit Claim",
    "page": "Submit Claim",
    "inputs": [
     {
      "name": "hospital_name",
      "checks": [
       {
        "rule": "required",
        "message": "Hospital name is required"
       }
      ]
     },
     {
      "name": "admission_date",
      "checks": [
       {
        "rule": "required",
        "message": "Admission date is required"
       },
       {
        "rule": "date",
        "message": "Invalid admission date"
       }
      ]
     },
     {
      "name": "discharge_date",
      "checks": [
       {
        "rule": "required",
        "message": "Discharge date is required"
       },
       {
        "rule": "date",
        "message": "Invalid discharge date"
       }
      ]
     },
     {
      "name": "claim_amount",
      "checks": [
       {
        "rule": "required",
        "message": "Claim amount is required"
       },
       {
        "rule": "number",
        "message": "Invalid claim amount"
       },
       {
        "rule": "min",
        "value": 0.01,
        "message": "Claim amount must be greater than zero"
       }
      ]
     },
     {
      "name": "document_name",
      "checks": [
       {
        "rule": "required",
        "message": "Document is required"
       },
       {
        "rule": "pattern",
        "value": ".*\\.(pdf|PDF|jpg|JPG|jpeg|JPEG)",
        "message": "Upload a PDF or JPG"
       }
      ]
     },
     {
      "name": "document_size_mb",
      "checks": [
       {
        "rule": "required",
        "message": "Document size is required"
       },
       {
        "rule": "number",
        "message": "Invalid document size"
       },
       {
        "rule": "max",
        "value": 5,
        "message": "File must be 5 MB or smaller"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "holder",
      "entity": "PolicyHolder",
      "key": {
       "user": "email"
      },
      "missing": "Policy holder not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "ge": [
        {
         "input": "discharge_date"
        },
        {
         "input": "admission_date"
        }
       ]
      },
      "message": "Discharge date must be on or after admission date"
     },
     {
      "unless": {
       "le": [
        {
         "days_between": [
          {
           "input": "discharge_date"
          },
          {
           "today": true
          }
         ]
        },
        30
       ]
      },
      "message": "Claims must be filed within 30 days of discharge"
     },
     {
      "unless": {
       "le": [
        {
         "input": "claim_amount"
        },
        {
         "field": "holder.remaining_sum_insured"
        }
       ]
      },
      "message": {
       "format": [
        "Claim exceeds your remaining sum insured of {amount}",
        {
         "amount": {
          "format_money": [
           {
            "field": "holder.remaining_sum_insured"
           },
           "INR"
          ]
         }
        }
       ]
      }
     }
    ],
    "effects": [
     {
      "create": {
       "entity": "Claim",
       "as": "claim",
       "values": {
        "policy_holder": {
         "user": "email"
        },
        "hospital_name": {
         "input": "hospital_name"
        },
        "admission_date": {
         "input": "admission_date"
        },
        "discharge_date": {
         "input": "discharge_date"
        },
        "claim_amount": {
         "input": "claim_amount"
        },
        "document_name": {
         "input": "document_name"
        },
        "document_size_mb": {
         "input": "document_size_mb"
        },
        "submitted_on": {
         "today": true
        },
        "status": "Submitted",
        "approved_amount": 0,
        "deductible": 0
       }
      }
     }
    ],
    "message": {
     "format": [
      "Claim {id} submitted successfully",
      {
       "id": {
        "field": "claim.id"
       }
      }
     ]
    },
    "returns": {
     "claim_id": {
      "field": "claim.id"
     },
     "status": {
      "field": "claim.status"
     }
    },
    "next_page": "My Claims"
