      "checks": [
       {
        "rule": "required",
        "message": "Claim ID is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "claim",
      "entity": "Claim",
      "key": {
       "input": "claim_id"
      },
      "missing": "Claim not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "user": "role"
        },
        "reviewer"
       ]
      },
      "message": "You are not allowed to do this"
     },
     {
      "unless": {
       "eq": [
        {
         "field": "claim.status"
        },
        "Submitted"
       ]
      },
      "message": "Only submitted claims can be moved to review"
     }
    ],
    "effects": [
     {
      "set": {
       "record": "claim",
       "field": "status",
       "value": "Under Review"
      }
     }
    ],
    "message": "Claim moved to Under Review"
   },
   {
    "name": "approve_claim",
