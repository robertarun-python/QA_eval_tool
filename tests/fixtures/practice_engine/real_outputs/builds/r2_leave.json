        "field": "request.id"
       },
       "days": {
        "field": "request.days"
       }
      }
     ]
    },
    "returns": {
     "request_id": {
      "field": "request.id"
     },
     "days": {
      "field": "request.days"
     }
    }
   },
   {
    "name": "approve_leave",
    "label": "Approve Leave",
    "page": "Team Leave",
    "inputs": [
     {
      "name": "request_id",
      "checks": [
       {
        "rule": "required",
        "message": "Request ID is required"
       }
      ]
     },
     {
      "name": "comment",
      "checks": []
     }
    ],
    "load": [
     {
      "as": "request",
      "entity": "LeaveRequest",
      "key": {
       "input": "request_id"
      },
      "missing": "Leave request not found"
     },
     {
      "as": "employee",
      "entity": "Employee",
      "key": {
       "field": "request.employee"
      },
      "missing": "Employee not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "user": "role"
        },
        "Manager"
       ]
      },
      "message": "Only managers can approve leave"
     },
     {
      "unless": {
       "eq": [
        {
         "field": "request.status"
        },
        "Pending"
       ]
      },
      "message": "Only pending requests can be approved"
     }
    ],
    "effects": [
     {
      "set": {
       "record": "request",
       "field": "status",
       "value": "Approved"
      }
     },
     {
      "set": {
       "record": "request",
       "field": "manager_comment",
       "value": {
        "if": [
         {
          "empty": {
           "input": "comment"
          }
         },
         "Approved",
         {
          "input": "comment"
         }
        ]
       }
      }
     },
     {
      "if": [
       {
        "eq": [
         {
          "field": "request.leave_type"
         },
         "Casual"
        ]
       },
       [
        {
         "set": {
          "record": "employee",
          "field": "casual_balance",
          "value": {
           "sub": [
            {
             "field": "employee.casual_balance"
            },
            {
             "field": "request.days"
            }
           ]
          }
         }
        }
       ],
       [
        {
         "set": {
          "record": "employee",
          "field": "sick_balance",
          "value": {
           "sub": [
            {
             "field": "employee.sick_balance"
            },
            {
             "field": "request.days"
            }
           ]
          }
         }
        }
       ]
      ]
     },
     {
      "send": {
       "channel": "email",
       "to": {
        "field": "request.employee"
       },
       "subject": "Leave Request Approved",
       "body": {
        "format": [
         "Your leave request {id} has been approved.",
         {
          "id": {
           "field": "request.id"
          }
         }
        ]
       }
      }
     }
    ],
    "message": "Leave request approved successfully"
   },
   {
    "name": "reject_leave",
    "label": "Reject Leave",
    "page": "Team Leave",
    "inputs": [
     {
      "name": "request_id",
      "checks": [
       {
        "rule": "required",
        "message": "Request ID is required"
       }
      ]
     },
     {
      "name": "comment",
      "checks": [
       {
        "rule": "required",
        "message": "A comment is required to reject"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "request",
      "entity": "LeaveRequest",
      "key": {
       "input": "request_id"
      },
      "missing": "Leave request not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "user": "role"
        },
        "Manager"
       ]
      },
      "message": "Only managers can reject leave"
     },
     {
      "unless": {
       "eq": [
        {
         "field": "request.status"
        },
        "Pending"
       ]
      },
      "message": "Only pending requests can be rejected"
     }
    ],
    "effects": [
     {
      "set": {
       "record": "request",
       "field": "status",
       "value": "Rejected"
      }
     },
     {
      "set": {
       "record": "request",
       "field": "manager_comment",
       "value": {
        "input": "comment"
       }
      }
     },
     {
      "send": {
       "channel": "email",
       "to": {
        "field": "request.employee"
       },
       "subject": "Leave Request Rejected",
       "body": {
        "format": [
         "Your leave request {id} has been rejected. Reason: {comment}",
         {
          "id": {
           "field": "request.id"
          },
          "comment": {
           "input": "comment"
          }
         }
        ]
       }
      }
     }
    ],
    "message": "Leave request rejected"
   },
   {
    "name": "cancel_leave",
    "label": "Cancel Leave",
    "page": "My Leave",
    "inputs": [
     {
      "name": "request_id",
      "checks": [
       {
        "rule": "required",
        "message": "Request ID is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "request",
      "entity": "LeaveRequest",
      "key": {
       "input": "request_id"
      },
      "missing": "Leave request not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "field": "request.employee"
        },
        {
         "user": "email"
        }
       ]
      },
      "message": "You can only cancel your own leave requests"
     },
     {
      "unless": {
       "eq": [
        {
         "field": "request.status"
        },
        "Pending"
       ]
      },
      "message": "Approved leave can't be cancelled here"
     }
    ],
    "effects": [
     {
      "set": {
       "record": "request",
       "field": "status",
       "value": "Cancelled"
      }
     }
    ],
    "message": "Leave request cancelled successfully"
   }
  ],
  "faults": []
