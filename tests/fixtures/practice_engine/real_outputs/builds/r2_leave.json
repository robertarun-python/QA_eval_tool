  "actions": [
   {
    "name": "apply_leave",
    "label": "Apply Leave",
    "page": "Apply Leave",
    "inputs": [
     {
      "name": "leave_type",
      "checks": [
       {
        "rule": "required",
        "message": "Leave type is required"
       },
       {
        "rule": "one_of",
        "value": [
         "Casual",
         "Sick"
        ],
        "message": "Invalid leave type"
       }
      ]
     },
     {
      "name": "from_date",
      "checks": [
       {
        "rule": "required",
        "message": "From date is required"
       },
       {
        "rule": "date",
        "message": "Invalid from date"
       }
      ]
     },
     {
      "name": "to_date",
      "checks": [
       {
        "rule": "required",
        "message": "To date is required"
       },
       {
        "rule": "date",
        "message": "Invalid to date"
       }
      ]
     },
     {
      "name": "half_day",
      "checks": []
     },
     {
      "name": "reason",
      "checks": [
       {
        "rule": "required",
        "message": "Please enter a reason"
       }
      ]
     }
    ],
    "rules": [
     {
      "unless": {
       "le": [
        {
         "input": "from_date"
        },
        {
         "input": "to_date"
        }
       ]
      },
      "message": "From date must be on or before to date"
     },
     {
      "when": {
       "and": [
        {
         "eq": [
          {
           "input": "half_day"
          },
          true
         ]
        },
        {
         "ne": [
          {
           "input": "from_date"
          },
          {
           "input": "to_date"
          }
         ]
        }
       ]
      },
      "message": "Half day is for a single date only"
     },
     {
      "when": {
       "exists": {
        "entity": "LeaveRequest",
        "where": {
         "and": [
          {
           "eq": [
            {
             "field": "row.employee"
            },
            {
             "user": "email"
            }
           ]
          },
          {
           "in": [
            {
             "field": "row.status"
            },
            [
             "Pending",
             "Approved"
            ]
           ]
          },
          {
           "or": [
            {
             "and": [
              {
               "le": [
                {
                 "field": "row.from_date"
                },
                {
                 "input": "from_date"
                }
               ]
              },
              {
               "ge": [
                {
                 "field": "row.to_date"
                },
                {
                 "input": "from_date"
                }
               ]
              }
             ]
            },
            {
             "and": [
              {
               "le": [
                {
                 "field": "row.from_date"
                },
                {
                 "input": "to_date"
                }
               ]
              },
              {
               "ge": [
                {
                 "field": "row.to_date"
                },
                {
                 "input": "to_date"
                }
               ]
              }
             ]
            },
            {
             "and": [
              {
               "ge": [
                {
                 "field": "row.from_date"
                },
                {
                 "input": "from_date"
                }
               ]
              },
              {
               "le": [
                {
                 "field": "row.to_date"
                },
                {
                 "input": "to_date"
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        }
       }
      },
      "message": "You already have leave on these dates"
     },
     {
      "when": {
       "and": [
        {
         "eq": [
          {
           "input": "leave_type"
          },
          "Casual"
         ]
        },
        {
         "lt": [
          {
           "user": "casual_balance"
          },
          {
           "if": [
            {
             "eq": [
              {
               "input": "half_day"
              },
              true
             ]
            },
            0.5,
            {
             "working_days": [
              {
               "input": "from_date"
              },
              {
               "input": "to_date"
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      },
      "message": {
       "format": [
        "Insufficient casual leave balance ({balance} left)",
        {
         "balance": {
          "user": "casual_balance"
         }
        }
       ]
      }
     },
     {
      "when": {
       "and": [
        {
         "eq": [
          {
           "input": "leave_type"
          },
          "Sick"
         ]
        },
        {
         "lt": [
          {
           "user": "sick_balance"
          },
          {
           "if": [
            {
             "eq": [
              {
               "input": "half_day"
              },
              true
             ]
            },
            0.5,
            {
             "working_days": [
              {
               "input": "from_date"
              },
              {
               "input": "to_date"
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      },
      "message": {
       "format": [
        "Insufficient sick leave balance ({balance} left)",
        {
         "balance": {
          "user": "sick_balance"
         }
        }
       ]
      }
     }
    ],
    "effects": [
     {
      "create": {
       "entity": "LeaveRequest",
       "as": "request",
       "values": {
        "employee": {
         "user": "email"
        },
        "leave_type": {
         "input": "leave_type"
        },
        "from_date": {
         "input": "from_date"
        },
        "to_date": {
         "input": "to_date"
        },
        "half_day": {
         "input": "half_day"
        },
        "days": {
         "if": [
          {
           "eq": [
            {
             "input": "half_day"
            },
            true
           ]
          },
