          {
           "working_days": [
            {
             "input": "from_date"
            },
            {
             "input": "to_date"
            }
           ]
          }
         ]
        },
        "reason": {
         "input": "reason"
        },
        "status": "Pending",
        "manager_comment": "",
        "applied_on": {
         "now": true
        }
       }
      }
     }
    ],
    "message": {
     "format": [
      "Leave request submitted successfully. Request ID: {id}, Days: {days}",
      {
