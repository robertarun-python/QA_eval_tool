  "pages": [
   "Login",
   "Home",
   "Send Money",
   "Transaction History",
   "Payment Success"
  ],
  "public_pages": [],
  "home_page": "Home",
  "queries": [
   {
    "name": "transaction_history",
    "label": "Transaction History",
    "page": "Transaction History",
    "entity": "Transaction",
    "where": {
     "eq": [
      {
       "field": "row.from_mobile"
      },
      {
       "user": "mobile"
      }
     ]
    },
    "order_by": [
     {
      "field": "timestamp",
      "desc": true
     }
    ],
    "show": [
     "id",
     "to_upi",
     "amount",
     "timestamp",
     "status"
    ]
   }
  ],
  "actions": [
   {
    "name": "send_money",
    "label": "Pay",
    "page": "Send Money",
    "inputs": [
     {
      "name": "upi_id",
      "checks": [
       {
        "rule": "required",
        "message": "UPI ID is required"
       },
       {
        "rule": "pattern",
        "value": "[a-zA-Z0-9._-]+@[a-zA-Z0-9]+",
        "message": "Enter a valid UPI ID"
       }
      ]
     },
     {
      "name": "amount",
      "checks": [
       {
        "rule": "required",
        "message": "Amount is required"
       },
       {
        "rule": "number",
        "message": "Amount must be a number"
       },
       {
        "rule": "min",
        "value": 1,
        "message": "Enter an amount of at least Rs 1"
       },
       {
        "rule": "max",
        "value": 50000,
        "message": "Maximum Rs 50,000 per transaction"
       }
      ]
     },
     {
      "name": "upi_pin",
      "checks": [
       {
        "rule": "required",
        "message": "UPI PIN is required"
       },
       {
        "rule": "pattern",
        "value": "[0-9]{4}",
        "message": "UPI PIN must be 4 digits"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "current_user",
      "entity": "User",
      "key": {
       "user": "mobile"
      },
      "missing": "User not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "round": [
          {
           "mul": [
            {
             "input": "amount"
            },
            100
           ]
          },
          0
         ]
        },
        {
         "mul": [
          {
           "round": [
            {
             "input": "amount"
            },
            2
           ]
          },
          100
         ]
        }
       ]
      },
      "message": "Amount can have at most 2 decimal places"
     },
     {
      "when": {
       "and": [
        {
         "not": {
          "empty": {
           "field": "current_user.upi_blocked_at"
          }
         }
        },
        {
         "lt": [
          {
           "minutes_since": {
            "field": "current_user.upi_blocked_at"
           }
          },
          1440
         ]
        }
       ]
      },
      "message": "UPI blocked for 24 hours due to wrong PIN attempts"
     },
     {
      "unless": {
       "eq": [
        {
         "input": "upi_pin"
        },
        {
         "field": "current_user.upi_pin"
        }
       ]
      },
      "message": "Incorrect UPI PIN",
      "then": [
       {
        "set": {
         "record": "current_user",
         "field": "wrong_pin_count",
         "value": {
          "add": [
           {
            "field": "current_user.wrong_pin_count"
           },
           1
          ]
         }
        }
       },
       {
        "if": [
         {
          "ge": [
           {
            "add": [
             {
              "field": "current_user.wrong_pin_count"
             },
             1
            ]
           },
           3
          ]
         },
         [
          {
           "set": {
            "record": "current_user",
            "field": "upi_blocked_at",
            "value": {
             "now": true
            }
           }
          }
         ],
         []
        ]
       }
      ]
     },
     {
      "when": {
       "ge": [
        {
         "field": "current_user.wrong_pin_count"
        },
        3
       ]
      },
      "message": "UPI blocked for 24 hours due to wrong PIN attempts"
     },
     {
      "unless": {
       "ge": [
        {
         "field": "current_user.balance"
        },
        {
         "round": [
          {
           "input": "amount"
          },
          2
         ]
        }
       ]
      },
      "message": "Insufficient balance"
     },
     {
      "when": {
       "and": [
        {
         "eq": [
          {
           "field": "current_user.daily_spent_date"
          },
          {
           "today": true
          }
         ]
        },
        {
         "ge": [
          {
           "add": [
            {
             "field": "current_user.daily_spent"
            },
            {
             "round": [
              {
               "input": "amount"
              },
              2
             ]
            }
           ]
          },
          100000
         ]
        }
       ]
      },
      "message": "Daily limit of Rs 1,00,000 reached"
     }
    ],
    "effects": [
     {
      "set": {
       "record": "current_user",
       "field": "balance",
       "value": {
        "sub": [
         {
          "field": "current_user.balance"
         },
         {
          "round": [
           {
            "input": "amount"
           },
           2
          ]
         }
        ]
       }
      }
     },
     {
      "set": {
       "record": "current_user",
       "field": "wrong_pin_count",
       "value": 0
      }
     },
     {
      "set": {
       "record": "current_user",
       "field": "upi_blocked_at",
       "value": ""
      }
     },
     {
      "if": [
       {
        "eq": [
         {
          "field": "current_user.daily_spent_date"
         },
         {
          "today": true
         }
        ]
       },
       [
        {
         "set": {
          "record": "current_user",
          "field": "daily_spent",
          "value": {
           "add": [
            {
             "field": "current_user.daily_spent"
            },
            {
             "round": [
              {
               "input": "amount"
              },
              2
             ]
            }
           ]
          }
         }
        }
       ],
       [
        {
         "set": {
          "record": "current_user",
          "field": "daily_spent",
          "value": {
           "round": [
            {
             "input": "amount"
            },
            2
           ]
          }
         }
        },
        {
         "set": {
          "record": "current_user",
          "field": "daily_spent_date",
          "value": {
           "today": true
          }
         }
        }
       ]
      ]
     },
     {
      "create": {
       "entity": "Transaction",
       "as": "txn",
       "values": {
        "from_mobile": {
         "user": "mobile"
        },
        "to_upi": {
         "input": "upi_id"
        },
        "amount": {
         "round": [
          {
           "input": "amount"
          },
          2
         ]
        },
        "timestamp": {
         "now": true
        },
        "status": "Success"
       }
      }
     },
     {
      "send": {
       "channel": "sms",
       "to": {
        "user": "mobile"
       },
       "body": {
        "format": [
         "Payment of Rs {amount} to {upi} successful. Txn ID: {id}",
         {
          "amount": {
           "format_money": [
            {
             "round": [
              {
               "input": "amount"
              },
              2
             ]
            },
            "INR"
           ]
          },
          "upi": {
           "input": "upi_id"
          },
          "id": {
           "field": "txn.id"
          }
         }
        ]
       }
      }
     }
    ],
    "message": "Payment successful",
    "next_page": "Payment Success",
    "returns": {
     "transaction_id": {
      "field": "txn.id"
     },
     "new_balance": {
      "field": "current_user.balance"
     }
    }
   }
  ],
  "faults": [
   {
    "name": "bank_server_down",
