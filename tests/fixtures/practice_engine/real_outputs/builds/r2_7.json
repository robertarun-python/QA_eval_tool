    "entity": "Transaction",
    "inputs": [
     {
      "name": "tag_id",
      "checks": [
       {
        "rule": "required",
        "message": "FASTag ID is required"
       }
      ]
     }
    ],
    "where": {
     "eq": [
      {
       "field": "row.tag_id"
      },
      {
       "input": "tag_id"
      }
     ]
    },
    "order_by": [
     {
      "field": "timestamp",
      "desc": true
     }
    ],
    "show": [
     "id",
     "timestamp",
     "toll_plaza",
     "toll_amount",
     "balance_after",
     "status"
    ],
    "none_message": "No transactions found",
    "requires_login": false
   }
  ],
  "actions": [
   {
    "name": "process_toll",
    "label": "Process Toll",
    "page": "Toll Plaza",
    "requires_login": false,
    "inputs": [
     {
      "name": "tag_id",
      "checks": [
       {
        "rule": "required",
        "message": "FASTag ID is required"
       }
      ]
     },
     {
      "name": "actual_registration",
      "checks": [
       {
        "rule": "required",
        "message": "Vehicle registration number is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "tag",
      "entity": "FASTag",
      "key": {
       "input": "tag_id"
      },
      "missing": "FASTag not found"
     },
     {
      "as": "vehicle",
      "entity": "Vehicle",
      "key": {
       "field": "tag.registration_number"
      },
      "missing": "Vehicle not found"
     },
     {
      "as": "rate",
      "entity": "TollRate",
      "key": {
       "field": "vehicle.vehicle_type"
      },
      "missing": "Toll rate not configured for this vehicle type"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "field": "tag.status"
        },
        "Active"
       ]
      },
      "message": "FASTag is expired or inactive"
     },
     {
      "unless": {
       "eq": [
        {
         "upper": {
          "trim": {
           "field": "tag.registration_number"
          }
         }
        },
        {
         "upper": {
          "trim": {
           "input": "actual_registration"
          }
         }
        }
       ]
      },
      "message": "Vehicle-FASTag mismatch detected"
     },
     {
      "unless": {
       "ge": [
        {
         "field": "tag.balance"
        },
        {
         "field": "rate.toll_amount"
        }
       ]
      },
      "message": "Insufficient balance"
     }
    ],
    "effects": [
     {
      "create": {
       "entity": "Transaction",
       "as": "txn",
       "values": {
        "tag_id": {
         "field": "tag.tag_id"
        },
        "registration_number": {
         "field": "vehicle.registration_number"
        },
        "vehicle_type": {
         "field": "vehicle.vehicle_type"
        },
        "toll_plaza": "Plaza A",
        "toll_amount": {
         "field": "rate.toll_amount"
        },
        "balance_before": {
         "field": "tag.balance"
        },
        "balance_after": {
         "sub": [
          {
           "field": "tag.balance"
          },
          {
           "field": "rate.toll_amount"
          }
         ]
        },
        "timestamp": {
         "now": true
        },
        "status": "Success"
       }
      }
     },
     {
      "set": {
       "record": "tag",
       "field": "balance",
       "value": {
        "sub": [
         {
          "field": "tag.balance"
         },
         {
          "field": "rate.toll_amount"
         }
        ]
       }
      }
     },
     {
      "send": {
       "channel": "sms",
       "to": {
        "field": "vehicle.owner_mobile"
       },
       "body": {
        "format": [
         "Toll paid: {amount} at {plaza}. Balance: {balance}. Txn: {txn_id}",
         {
          "amount": {
           "format_money": [
            {
             "field": "rate.toll_amount"
            },
            "INR"
           ]
          },
          "plaza": "Plaza A",
          "balance": {
           "format_money": [
            {
             "field": "txn.balance_after"
            },
            "INR"
           ]
          },
          "txn_id": {
           "field": "txn.id"
          }
         }
        ]
       }
      }
     },
     {
      "if": [
       {
        "lt": [
         {
          "field": "txn.balance_after"
         },
         100
        ]
       },
       [
        {
         "send": {
          "channel": "alert",
          "to": {
           "field": "vehicle.owner_mobile"
          },
          "body": {
           "format": [
            "Low balance alert: {balance}. Please recharge your FASTag.",
            {
             "balance": {
              "format_money": [
               {
                "field": "txn.balance_after"
               },
               "INR"
              ]
             }
            }
           ]
          }
         }
        }
       ],
       []
      ]
     }
    ],
    "message": "Toll payment successful. Barrier opening.",
    "returns": {
     "transaction_id": {
      "field": "txn.id"
     },
     "toll_amount": {
      "field": "rate.toll_amount"
     },
     "balance_after": {
      "field": "txn.balance_after"
     }
    },
    "next_page": "Transaction Details"
   }
  ],
  "faults": []
 },
