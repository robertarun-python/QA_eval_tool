   {
    "name": "seat_map",
    "label": "Seat map",
    "page": "Show Details",
    "entity": "Seat",
    "as": "seat_query",
    "inputs": [
     {
      "name": "show_id",
      "checks": [
       {
        "rule": "required",
        "message": "Show is required"
       }
      ]
     }
    ],
    "where": {
     "eq": [
      {
       "field": "row.show_id"
      },
      {
       "input": "show_id"
      }
     ]
    },
    "order_by": [
     {
      "field": "seat_code"
     }
    ],
    "show": [
     "seat_code",
     "seat_type",
     {
      "name": "display_status",
      "value": {
       "if": [
        {
         "and": [
          {
           "eq": [
            {
             "field": "row.status"
            },
            "Held"
           ]
          },
          {
           "gt": [
            {
             "minutes_since": {
              "field": "row.held_at"
             }
            },
            10
           ]
          }
         ]
        },
        "Available",
        {
         "field": "row.status"
        }
       ]
      }
     }
    ],
    "none_message": "No seats found"
   }
  ],
  "actions": [
   {
    "name": "select_seats",
    "label": "Select Seats",
    "page": "Show Details",
    "inputs": [
     {
      "name": "show_id",
      "checks": [
       {
        "rule": "required",
        "message": "Show is required"
       }
      ]
     },
     {
      "name": "seats",
      "checks": [
       {
        "rule": "required",
        "message": "Please select at least one seat"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "show",
      "entity": "Show",
      "key": {
       "input": "show_id"
      },
      "missing": "Show not found"
     }
    ],
    "rules": [
     {
      "when": {
       "ge": [
        {
         "now": true
        },
        {
         "field": "show.show_time"
        }
       ]
      },
      "message": "Booking is closed for this show"
     },
     {
      "when": {
       "gt": [
        {
         "length": {
          "split": [
           {
            "input": "seats"
           },
           ","
          ]
         }
        },
        6
       ]
      },
      "message": "You can book at most 6 seats"
     },
     {
      "for_each": {
       "list": {
        "split": [
         {
          "input": "seats"
         },
         ","
        ]
       },
       "as": "s"
      },
      "when": {
       "gt": [
        {
         "occurrences": [
          {
           "split": [
            {
             "input": "seats"
            },
            ","
           ]
          },
          {
           "field": "s.value"
          }
         ]
        },
        1
       ]
      },
      "message": {
       "format": [
        "Seat {code} selected twice",
        {
         "code": {
          "field": "s.value"
         }
        }
       ]
      }
     },
     {
      "for_each": {
       "list": {
        "split": [
         {
          "input": "seats"
         },
         ","
        ]
       },
       "as": "s"
      },
      "unless": {
       "exists": {
        "entity": "Seat",
        "where": {
         "and": [
          {
           "eq": [
            {
             "field": "row.show_id"
            },
            {
             "input": "show_id"
            }
           ]
          },
          {
           "eq": [
            {
             "field": "row.seat_code"
            },
            {
             "field": "s.value"
            }
           ]
          }
         ]
        }
       }
      },
      "message": {
       "format": [
        "Seat {code} does not exist",
        {
         "code": {
          "field": "s.value"
         }
        }
       ]
      }
     },
     {
      "for_each": {
       "list": {
        "split": [
         {
          "input": "seats"
         },
         ","
        ]
       },
       "as": "s"
      },
      "when": {
       "exists": {
        "entity": "Seat",
        "where": {
         "and": [
          {
           "eq": [
            {
             "field": "row.show_id"
            },
            {
             "input": "show_id"
            }
           ]
          },
          {
           "eq": [
            {
             "field": "row.seat_code"
            },
            {
             "field": "s.value"
            }
           ]
          },
          {
           "eq": [
            {
             "field": "row.status"
            },
            "Sold"
           ]
          }
         ]
        }
       }
      },
      "message": {
       "format": [
        "Seat {code} is not available",
        {
         "code": {
          "field": "s.value"
         }
        }
       ]
      }
     },
     {
      "for_each": {
       "list": {
        "split": [
         {
          "input": "seats"
         },
         ","
        ]
       },
       "as": "s"
      },
      "when": {
       "exists": {
        "entity": "Seat",
        "where": {
         "and": [
          {
           "eq": [
            {
             "field": "row.show_id"
            },
            {
             "input": "show_id"
            }
           ]
          },
          {
           "eq": [
            {
             "field": "row.seat_code"
            },
            {
             "field": "s.value"
            }
           ]
          },
          {
           "eq": [
            {
             "field": "row.status"
            },
            "Held"
           ]
          },
          {
           "le": [
            {
             "minutes_since": {
              "field": "row.held_at"
             }
            },
            10
           ]
          }
         ]
        }
       }
      },
      "message": {
       "format": [
        "Seat {code} is not available",
        {
         "code": {
          "field": "s.value"
         }
        }
       ]
      }
     }
    ],
    "effects": [
     {
      "for_each": {
       "entity": "Seat",
       "where": {
        "and": [
         {
          "eq": [
           {
            "field": "row.show_id"
           },
           {
            "input": "show_id"
           }
          ]
         },
         {
          "in": [
           {
            "field": "row.seat_code"
           },
           {
            "split": [
             {
              "input": "seats"
             },
             ","
            ]
           }
          ]
         }
        ]
       },
       "as": "seat",
       "effects": [
        {
         "set": {
          "record": "seat",
          "field": "status",
          "value": "Held"
         }
        },
        {
         "set": {
          "record": "seat",
          "field": "held_by",
          "value": {
           "user": "email"
          }
         }
        },
        {
         "set": {
          "record": "seat",
          "field": "held_at",
          "value": {
           "now": true
          }
         }
        }
       ]
      }
     },
     {
      "set_session": {
       "key": "show_id",
       "value": {
        "input": "show_id"
       }
      }
     },
     {
      "set_session": {
       "key": "seats",
       "value": {
        "input": "seats"
       }
      }
     },
     {
      "set_session": {
       "key": "hold_time",
       "value": {
        "now": true
       }
      }
     }
    ],
    "message": "Seats selected successfully",
    "next_page": "Seat Selection"
   },
   {
    "name": "make_payment",
    "label": "Pay",
    "page": "Seat Selection",
    "inputs": [],
    "load": [
     {
      "as": "show",
      "entity": "Show",
      "key": {
       "session": "show_id"
      },
      "missing": "Show not found"
     }
    ],
    "rules": [
     {
      "unless": {
       "not": {
        "empty": {
         "session": "hold_time"
        }
       }
      },
      "message": "No seats selected"
     },
     {
      "when": {
       "gt": [
        {
         "minutes_since": {
          "session": "hold_time"
         }
        },
        10
       ]
      },
      "message": "Your seat hold has expired"
     }
    ],
    "effects": [
     {
      "for_each": {
       "entity": "Seat",
       "where": {
        "and": [
         {
          "eq": [
           {
            "field": "row.show_id"
           },
           {
            "session": "show_id"
           }
          ]
         },
         {
          "in": [
           {
            "field": "row.seat_code"
           },
           {
            "split": [
             {
              "session": "seats"
             },
             ","
            ]
           }
          ]
         }
        ]
       },
       "as": "seat",
       "effects": [
        {
         "set": {
          "record": "seat",
          "field": "status",
          "value": "Sold"
         }
        },
        {
         "set": {
          "record": "seat",
          "field": "held_by",
          "value": ""
         }
        },
        {
         "set": {
          "record": "seat",
          "field": "held_at",
          "value": ""
         }
        }
       ]
      }
     },
     {
      "create": {
       "entity": "Booking",
       "as": "booking",
       "values": {
        "user_email": {
         "user": "email"
        },
        "show_id": {
         "session": "show_id"
        },
        "seats": {
         "session": "seats"
        },
        "ticket_amount": {
         "round": [
          {
           "sum": {
            "entity": "Seat",
            "where": {
             "and": [
              {
               "eq": [
                {
                 "field": "row.show_id"
                },
                {
                 "session": "show_id"
                }
               ]
              },
              {
               "in": [
                {
                 "field": "row.seat_code"
                },
                {
                 "split": [
                  {
                   "session": "seats"
                  },
                  ","
                 ]
                }
               ]
              }
             ]
            },
            "field": "price"
           }
          },
          2
         ]
        },
        "convenience_fee": {
         "round": [
          {
           "mul": [
            {
             "length": {
              "split": [
               {
                "session": "seats"
               },
               ","
              ]
             }
            },
            30
           ]
          },
          2
         ]
        },
        "gst": {
         "round": [
          {
           "mul": [
            {
             "mul": [
              {
               "length": {
                "split": [
                 {
                  "session": "seats"
                 },
                 ","
                ]
               }
              },
              30
             ]
            },
            0.18
           ]
          },
          2
         ]
        },
        "total_amount": {
         "round": [
          {
           "add": [
            {
             "add": [
              {
               "sum": {
                "entity": "Seat",
                "where": {
                 "and": [
                  {
                   "eq": [
                    {
                     "field": "row.show_id"
                    },
                    {
                     "session": "show_id"
                    }
                   ]
                  },
                  {
                   "in": [
                    {
                     "field": "row.seat_code"
                    },
                    {
                     "split": [
                      {
                       "session": "seats"
                      },
                      ","
                     ]
                    }
                   ]
                  }
                 ]
                },
                "field": "price"
               }
              },
              {
               "mul": [
                {
                 "length": {
                  "split": [
                   {
                    "session": "seats"
                   },
                   ","
                  ]
                 }
                },
                30
               ]
              }
             ]
            },
            {
             "mul": [
              {
               "mul": [
                {
                 "length": {
                  "split": [
                   {
                    "session": "seats"
                   },
                   ","
                  ]
                 }
                },
                30
               ]
              },
              0.18
             ]
            }
           ]
          },
          2
         ]
        },
        "booked_at": {
         "now": true
        },
        "status": "Confirmed"
       }
      }
     },
     {
      "clear_session": "show_id"
     },
     {
      "clear_session": "seats"
     },
     {
      "clear_session": "hold_time"
     }
    ],
    "message": "Booking confirmed",
    "next_page": "Booking Confirmation",
    "returns": {
     "booking_id": {
      "field": "booking.id"
     },
     "total_amount": {
      "field": "booking.total_amount"
     }
    }
   }
  ],
  "faults": [
