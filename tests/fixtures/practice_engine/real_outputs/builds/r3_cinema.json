     }
    },
    {
     "call": "Database.find_booking",
     "args": [
      "id",
      {
       "ref": "result.booking_id"
      }
     ],
     "save_as": "booking_records"
    },
    {
     "check": {
      "ref": "booking_records.0.total_amount"
