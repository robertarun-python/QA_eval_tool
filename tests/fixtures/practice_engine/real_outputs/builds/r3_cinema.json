     "call": "UI.visible_message",
     "expect": "Booking confirmed"
    },
    {
     "call": "UI.current_page",
     "expect": "Booking Confirmation"
    },
    {
     "call": "UI.last_result",
     "save_as": "result",
     "expect_includes": {
