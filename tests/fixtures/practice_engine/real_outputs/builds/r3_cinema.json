     ],
     "save_as": "seat_a1"
    },
    {
     "check": {
      "ref": "seat_a1.0.status"
     },
     "expect": "Sold"
    },
    {
     "call": "Database.find_seat",
     "args": [
      "seat_code",
      "A2"
     ],
     "save_as": "seat_a2"
    },
    {
     "check": {
