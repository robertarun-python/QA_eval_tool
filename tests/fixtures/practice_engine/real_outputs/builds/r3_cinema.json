     },
     "expect": 60.0
    },
    {
     "check": {
      "ref": "booking_records.0.gst"
     },
     "expect": 10.8
    },
    {
     "check": {
      "ref": "booking_records.0.seats"
     },
     "expect": "A1,A2"
    },
    {
     "call": "Database.find_seat",
     "args": [
