       {
        "rule": "required",
        "message": "New password is required"
       },
       {
        "rule": "min_length",
        "value": 8,
        "message": "Password must be 8-20 characters with an upper-case letter, a digit and a special character"
       },
       {
        "rule": "max_length",
        "value": 20,
        "message": "Password must be 8-20 characters with an upper-case letter, a digit and a special character"
       },
       {
        "rule": "pattern",
        "value": "^(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9]).+$",
        "message": "Password must be 8-20 characters with an upper-case letter, a digit and a special character"
       }
      ]
     },
     {
      "name": "confirm_password",
      "checks": [
       {
        "rule": "required",
        "message": "Confirm password is required"
       }
      ]
     }
    ],
    "load": [
     {
      "as": "user",
      "entity": "User",
      "key": {
       "input": "email_address"
      },
      "missing": "Invalid reset code"
     },
     {
      "as": "reset",
      "entity": "PasswordReset",
      "key": {
       "input": "reset_code"
      },
      "missing": "Invalid reset code"
     }
    ],
    "rules": [
     {
      "unless": {
       "eq": [
        {
         "field": "reset.email"
        },
        {
         "field": "user.email"
        }
       ]
      },
      "message": "Invalid reset code"
     },
     {
      "unless": {
       "eq": [
        {
         "field": "reset.status"
        },
        "Pending"
       ]
      },
      "message": "Invalid reset code"
     },
     {
      "when": {
       "gt": [
        {
         "minutes_since": {
          "field": "reset.requested_at"
         }
        },
        10
       ]
      },
      "message": "Code has expired"
     },
     {
      "unless": {
       "eq": [
        {
         "input": "new_password"
        },
        {
         "input": "confirm_password"
        }
       ]
      },
      "message": "Passwords do not match"
     },
     {
      "when": {
       "eq": [
        {
         "input": "new_password"
        },
        {
         "field": "user.password"
        }
       ]
      },
      "message": "You can't reuse your last 3 passwords"
     },
     {
      "when": {
       "matches": [
        {
         "field": "user.password_history"
        },
        "(^|\\|)password(\\||$)"
       ]
      },
      "message": "You can't reuse your last 3 passwords"
     }
    ],
    "effects": [
     {
      "set": {
       "record": "user",
       "field": "password_history",
       "value": {
        "if": [
         {
          "lt": [
           {
            "length": {
             "split": [
              {
               "field": "user.password_history"
              },
              "|"
             ]
            }
           },
           3
          ]
         },
         {
          "concat": [
           {
            "input": "new_password"
           },
           "|",
           {
            "field": "user.password_history"
           }
          ]
         },
         {
          "concat": [
           {
            "input": "new_password"
           },
           "|",
           {
            "if": [
             {
              "gt": [
               {
                "length": {
                 "split": [
                  {
                   "field": "user.password_history"
                  },
                  "|"
                 ]
                }
               },
               0
              ]
             },
             {
              "concat": [
               {
                "if": [
                 {
                  "eq": [
                   {
                    "length": {
                     "split": [
                      {
                       "field": "user.password_history"
                      },
                      "|"
                     ]
                    }
                   },
                   1
                  ]
                 },
                 {
                  "field": "user.password_history"
                 },
                 {
                  "if": [
                   {
                    "eq": [
                     {
                      "length": {
                       "split": [
                        {
                         "field": "user.password_history"
                        },
                        "|"
                       ]
                      }
                     },
                     2
                    ]
                   },
                   {
                    "field": "user.password_history"
                   },
                   {
                    "if": [
                     {
                      "matches": [
                       {
                        "field": "user.password_history"
                       },
                       "^([^|]+)\\|([^|]+)\\|"
                      ]
                     },
                     {
                      "field": "user.password_history"
                     },
                     {
                      "field": "user.password_history"
                     }
                    ]
                   }
                  ]
                 }
                ]
               }
              ]
             },
             ""
            ]
           }
          ]
         }
        ]
       }
      }
     },
     {
      "set": {
       "record": "user",
       "field": "password",
       "value": {
        "input": "new_password"
       }
      }
     },
     {
