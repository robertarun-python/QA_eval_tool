   },
   {
    "call": "UI.open_doctor",
    "args": [
     "Dr. Sarah Johnson"
    ]
   },
   {
    "call": "UI.book",
    "args": [
     "2025-01-16",
     "09:00"
    ],
    "expect": false
   },
   {
    "call": "UI.visible_message",
    "expect": "This slot is no longer available"
   },
   {
    "call": "Database.appointments_for",
    "args": [
     "qa.patient.demo@testportal.io"
    ],
    "expect": []
   }
  ]
 },
 {
