 {
  "id": "teardown-cancels",
  "title": "Cleaning up cancels the booking and frees the slot",
  "steps": [
   {
    "call": "setup"
   },
   {
    "call": "UI.login",
    "args": [
     "qa.patient.demo@testportal.io",
     "Px!7mK@2024Test"
    ],
    "expect": true
   },
   {
    "call": "UI.open_doctor",
    "args": [
     "Dr. Sarah Johnson"
    ]
   },
   {
    "call": "UI.book",
    "args": [
     "2025-01-17",
     "14:00"
    ],
    "expect": true
   },
   {
    "call": "UI.confirmation",
    "save_as": "conf"
   },
   {
    "call": "teardown",
    "args": [
     {
      "ref": "conf.id"
     }
    ]
   },
   {
    "call": "Database.find_appointment",
    "args": [
     {
      "ref": "conf.id"
     }
    ],
    "expect": null
   },
   {
    "call": "Database.slot_is_booked",
    "args": [
     "D-101",
     "2025-01-17",
     "14:00"
    ],
    "expect": false
   }
  ]
 },
 {
  "id": "api-booking",
  "title": "Book through the API and read it back",
  "steps": [
   {
    "call": "setup"
   },
   {
    "call": "API.login",
    "args": [
     "qa.patient.demo@testportal.io",
     "Px!7mK@2024Test"
    ]
   },
   {
    "call": "API.book",
    "args": [
     "qa.patient.demo@testportal.io",
     "D-102",
     "2025-01-17",
     "14:00"
    ],
    "save_as": "booked",
    "expect_includes": {
     "ok": true
    }
   },
   {
    "call": "API.get_appointment",
    "args": [
     {
      "ref": "booked.appointment_id"
     }
    ],
    "expect_includes": {
     "doctor_name": "Dr. Michael Chen",
     "status": "confirmed"
    }
   },
   {
    "call": "Database.find_appointment",
    "args": [
     {
      "ref": "booked.appointment_id"
     }
    ],
    "expect_includes": {
     "status": "confirmed",
     "doctor_id": "D-102"
    }
   },
   {
    "call": "API.book",
    "args": [
     "qa.patient.demo@testportal.io",
     "D-102",
     "2025-01-17",
     "14:00"
    ],
    "expect_includes": {
     "ok": false,
     "error": "This slot is no longer available"
    }
   }
  ]
 }
]