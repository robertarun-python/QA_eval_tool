 {
  "id": "dates-and-slots",
  "title": "View available dates and slots (a taken slot is not offered)",
  "steps": [
   {
    "call": "setup"
   },
   {
    "call": "UI.login",
    "args": [
     "qa.patient.demo@testportal.io",
     "Px!7mK@2024Test"
    ],
    "expect": true
   },
   {
    "call": "UI.open_doctor",
    "args": [
     "Dr. Sarah Johnson"
    ]
   },
   {
    "call": "UI.available_dates",
    "expect": [
     "2025-01-15",
     "2025-01-16",
     "2025-01-17"
    ]
   },
   {
    "call": "UI.available_slots",
    "args": [
     "2025-01-15"
    ],
    "expect": [
     "09:00",
     "10:30",
     "14:00",
     "15:30"
    ]
   },
   {
    "call": "UI.available_slots",
    "args": [
     "2025-01-16"
    ],
    "expect": [
     "10:30",
     "14:00",
     "15:30"
    ]
   }
  ]
 },
 {
  "id": "book-free-slot",
  "title": "Book an available slot and see the confirmation",
  "steps": [
   {
    "call": "setup"
   },
   {
    "call": "UI.login",
    "args": [
     "qa.patient.demo@testportal.io",
     "Px!7mK@2024Test"
    ],
    "expect": true
   },
   {
    "call": "UI.open_doctor",
    "args": [
     "Dr. Sarah Johnson"
    ]
   },
   {
    "call": "UI.book",
    "args": [
     "2025-01-15",
     "09:00"
    ],
    "expect": true
   },
   {
    "call": "UI.current_page",
    "expect": "Confirmation"
   },
   {
    "call": "UI.visible_message",
    "expect": "Appointment confirmed"
   },
   {
    "call": "UI.confirmation",
    "save_as": "conf",
    "expect_includes": {
     "doctor_name": "Dr. Sarah Johnson",
     "specialty": "Cardiology",
     "date": "2025-01-15",
     "time": "09:00",
     "fee": 150,
     "status": "confirmed"
    }
   },
   {
    "call": "Database.find_appointment",
    "args": [
     {
      "ref": "conf.id"
     }
    ],
    "expect_includes": {
     "status": "confirmed",
     "patient_email": "qa.patient.demo@testportal.io"
    }
   },
   {
    "call": "Database.slot_is_booked",
    "args": [
     "D-101",
     "2025-01-15",
     "09:00"
    ],
    "expect": true
   },
   {
    "call": "UI.available_slots",
    "args": [
     "2025-01-15"
    ],
    "expect_excludes": [
     "09:00"
    ]
   }
  ]
 },
 {
