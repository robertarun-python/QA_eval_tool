# Copy this file to .env and fill in real values. Never commit .env.

# Get this from https://console.anthropic.com/ (pay-as-you-go API key)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required - the app refuses to start without this (see config.py).
# Any long random string — used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-string

# SQLite file path (relative to backend/ when running uvicorn from there)
DATABASE_URL=sqlite:///./qa_eval.db

# Claude model to use for scoring/generation calls
CLAUDE_MODEL=claude-sonnet-4-5

# Seeded accounts - this is a screening tool with fixed, pre-provisioned
# logins (no open signup). Passwords are required - the app refuses to
# start without them (see config.py), same reasoning as JWT_SECRET_KEY
# above: no fallback default means no known-weak password sitting in the
# repo. Change these to real random values, then run `python -m app.seed`
# (from backend/) to create the accounts - it only creates ones that
# don't already exist, so changing a password here after the account was
# already seeded needs a direct DB update instead (see app/seed.py).
HR_EMAIL=hr@example.com
HR_PASSWORD=change-me-hr
CANDIDATE1_EMAIL=candidate1@example.com
CANDIDATE1_PASSWORD=change-me-c1
CANDIDATE2_EMAIL=candidate2@example.com
CANDIDATE2_PASSWORD=change-me-c2
CANDIDATE3_EMAIL=candidate3@example.com
CANDIDATE3_PASSWORD=change-me-c3
