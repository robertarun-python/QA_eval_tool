# Copy this file to .env and fill in real values. Never commit .env.

# Get this from https://console.anthropic.com/ (pay-as-you-go API key)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any long random string — used to sign login tokens
JWT_SECRET_KEY=change-me-to-a-random-string

# SQLite file path (relative to backend/ when running uvicorn from there)
DATABASE_URL=sqlite:///./qa_eval.db

# Claude model to use for scoring/generation calls
CLAUDE_MODEL=claude-sonnet-4-5

# Seeded accounts - this is a screening tool with fixed, pre-provisioned
# logins (no open signup). Change these, then run `python -m app.seed`
# (from backend/) to create/update the accounts. Bands are fixed in
# seed.py: candidates 1-2 are 0-7yrs, candidate 3 is 7+yrs.
HR_EMAIL=hr@example.com
HR_PASSWORD=change-me-hr
CANDIDATE1_EMAIL=candidate1@example.com
CANDIDATE1_PASSWORD=change-me-c1
CANDIDATE2_EMAIL=candidate2@example.com
CANDIDATE2_PASSWORD=change-me-c2
CANDIDATE3_EMAIL=candidate3@example.com
CANDIDATE3_PASSWORD=change-me-c3
