.DS_Store

# Stale backup from an earlier broken `git init` attempt (contains a
# nested .git) - not part of the project, kept only until you're ready
# to delete it yourself.
_to_delete/

# Personal scratch notes - as of writing this contains a live API key
# in plaintext. Never track this; move the key to .env instead.
QA tool info.txt

# Plaintext login reference sheet (seeded account emails/passwords) -
# same reasoning as "QA tool info.txt" above. Never track this.
logins.txt

# Ad-hoc agent/review output saved to disk (audits, reports) - not
# source, not meant to be shared via version control.
Claude outputs/

# Generated report output (HR's candidate-summary and daily cohort PDF
# exports), not source. The `*` before .pdf also catches the "(1)"/"(2)"
# suffix a browser adds on a repeat download of the same filename.
*-summary*.pdf
cohort-*.pdf

# Locally-installed third-party agent skill packages, not app code.
backend/.claude/
backend/.agents/
backend/skills-lock.json

# Local git worktrees used for isolated subagent-driven development work.
.worktrees/

# Personal Claude Code settings override, not shared with the team.
.claude/settings.local.json
